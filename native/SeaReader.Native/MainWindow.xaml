                                    <TextBlock Text="{Binding FormatLabel}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource LibraryAccent}"/>
                                    <TextBlock Text="{Binding ReadingLabel}" FontSize="11" Foreground="{DynamicResource LibraryQuiet}"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Display.Title}" FontWeight="SemiBold"
                                               ToolTip="{Binding Display.Title}" TextTrimming="CharacterEllipsis"/>
