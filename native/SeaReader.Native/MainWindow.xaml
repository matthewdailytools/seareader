<Window x:Class="SeaReader.Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SeaReader.Native"
        Title="SeaReader" Width="1120" Height="770" MinWidth="400" MinHeight="370"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14"
        Background="{DynamicResource WindowSurface}" Foreground="{DynamicResource MainInk}"
        AllowDrop="True" PreviewDragOver="OnDragOver" PreviewDrop="OnDrop" PreviewKeyDown="OnKeyDown"
        Deactivated="OnReaderDeactivated">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowSurface" Color="#EDF1F1"/>
        <SolidColorBrush x:Key="PaperSurface" Color="#F7FAF9"/>
        <SolidColorBrush x:Key="ToolbarSurface" Color="#F7FAF9"/>
        <SolidColorBrush x:Key="FloatingReaderSurface" Color="#EBF7FAF9"/>
        <SolidColorBrush x:Key="MainInk" Color="#202F34"/>
        <SolidColorBrush x:Key="MutedInk" Color="#53676C"/>
        <SolidColorBrush x:Key="BorderInk" Color="#CAD7D7"/>
        <SolidColorBrush x:Key="AccentInk" Color="#276864"/>
        <SolidColorBrush x:Key="HoverSurface" Color="#E0ECEA"/>
        <Thickness x:Key="ReaderInsets">32,30</Thickness>
        <Thickness x:Key="FacingReaderInsets">32,30</Thickness>
        <SolidColorBrush x:Key="ReaderPaper" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ReaderLinkInk" Color="#276864"/>
        <SolidColorBrush x:Key="ReaderPaperBorder" Color="#D5DEDF"/>
        <SolidColorBrush x:Key="ReaderPrimaryFill" Color="#276864"/>
        <SolidColorBrush x:Key="ReaderPrimaryInk" Color="#FFFFFF"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MainInk}"/>
            <Setter Property="Background" Value="{DynamicResource PaperSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderInk}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource AccentInk}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource AccentInk}"/>
                                <Setter TargetName="ButtonSurface" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value=".5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ReaderAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="ReaderActiveAction" TargetType="Button" BasedOn="{StaticResource ReaderAction}">
            <Setter Property="Background" Value="{DynamicResource HoverSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentInk}"/>
        </Style>
        <Style x:Key="ReaderJumpAction" TargetType="Button" BasedOn="{StaticResource ReaderAction}">
            <Setter Property="Background" Value="{DynamicResource FloatingReaderSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ReaderPaperBorder}"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="ReaderThemeChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource MainInk}"/>
            <Setter Property="Background" Value="{DynamicResource PaperSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderInk}"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChoiceFrame" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="6,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceFrame" Property="Background" Value="{DynamicResource HoverSurface}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChoiceFrame" Property="BorderBrush" Value="{DynamicResource AccentInk}"/>
                                <Setter TargetName="ChoiceFrame" Property="Background" Value="{DynamicResource HoverSurface}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ChoiceFrame" Property="BorderBrush" Value="{DynamicResource MainInk}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ReaderIllustrationButton" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent" ClipToBounds="True">
                            <ContentPresenter/>
                            <Border x:Name="IllustrationFocusRing" BorderBrush="{DynamicResource ReaderPrimaryFill}"
                                    BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False"/>
                            <Border x:Name="IllustrationZoomCue" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="6" Padding="5" CornerRadius="5" Background="{DynamicResource ReaderPrimaryFill}"
                                    Visibility="Collapsed" IsHitTestVisible="False">
                                <Path Data="M16,16 L11,11 M12,7 A5,5 0 1 1 2,7 A5,5 0 1 1 12,7 M7,4 L7,10 M4,7 L10,7"
                                      Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource ReaderPrimaryInk}" StrokeThickness="1.5"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IllustrationZoomCue" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="IllustrationZoomCue" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="IllustrationFocusRing" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource ReaderPrimaryFill}"/>
            <Setter Property="Foreground" Value="{DynamicResource ReaderPrimaryInk}"/>
        </Style>
        <Style x:Key="ReaderProgressSlider" TargetType="Slider">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border x:Name="ProgressFocusCue" CornerRadius="5" IsHitTestVisible="False" Opacity="0"
                                    BorderBrush="{DynamicResource AccentInk}" BorderThickness="1"/>
                            <Border Height="4" Margin="10,0" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{DynamicResource BorderInk}" IsHitTestVisible="False"/>
                            <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent">
                                                    <Border x:Name="ReadProgressFill" Height="4" VerticalAlignment="Center" Margin="10,0,0,0"
                                                            Background="{DynamicResource AccentInk}" CornerRadius="2"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsDirectionReversed, RelativeSource={RelativeSource AncestorType=Track}}" Value="True">
                                                        <Setter TargetName="ReadProgressFill" Property="Margin" Value="0,0,10,0"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="20" Height="28" Focusable="False" Cursor="SizeWE">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="Transparent">
                                                    <Ellipse Width="16" Height="16" VerticalAlignment="Center"
                                                             HorizontalAlignment="Center" Fill="{DynamicResource AccentInk}"
                                                             Stroke="{DynamicResource ToolbarSurface}" StrokeThickness="1"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ProgressFocusCue" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PageEdgeButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <Border x:Name="ArrowSurface" Height="46" Opacity="0" VerticalAlignment="Center"
                                    CornerRadius="12" Background="{DynamicResource ToolbarSurface}"
                                    BorderBrush="{DynamicResource BorderInk}" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ArrowSurface" Property="Opacity" Value="1"/>
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ArrowSurface" Property="Background" Value="{DynamicResource HoverSurface}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource MainInk}"/>
            <Setter Property="Background" Value="{DynamicResource PaperSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderInk}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="6,4,0,4"/>
            <Setter Property="MinHeight" Value="29"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid x:Name="LibrarySurface" Background="{DynamicResource LibraryCanvas}"
              TextElement.Foreground="{DynamicResource LibraryInk}" SizeChanged="OnLibrarySizeChanged">
            <Grid.Resources>
                <SolidColorBrush x:Key="LibraryCanvas" Color="#F8F7F3"/>
                <SolidColorBrush x:Key="LibraryRail" Color="#EEEFE8"/>
                <SolidColorBrush x:Key="LibraryPaper" Color="#FDFCF8"/>
                <SolidColorBrush x:Key="LibraryInk" Color="#233733"/>
                <SolidColorBrush x:Key="LibraryQuiet" Color="#576862"/>
                <SolidColorBrush x:Key="LibraryRule" Color="#D6DED4"/>
                <SolidColorBrush x:Key="LibraryAccent" Color="#2E6A5E"/>
                <SolidColorBrush x:Key="LibrarySelection" Color="#DCEBE2"/>
                <SolidColorBrush x:Key="LibraryRecent" Color="#EEF3EA"/>
                <SolidColorBrush x:Key="LibraryOnAccent" Color="White"/>
                <ItemsPanelTemplate x:Key="LibraryRailStack">
                    <StackPanel/>
                </ItemsPanelTemplate>
                <ItemsPanelTemplate x:Key="LibraryRailWrap">
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
                <ItemsPanelTemplate x:Key="LibraryShelfGridPanel">
                    <WrapPanel/>
                </ItemsPanelTemplate>
                <ItemsPanelTemplate x:Key="LibraryShelfRowsPanel">
                    <StackPanel/>
                </ItemsPanelTemplate>
                <Style x:Key="LibraryPicker" TargetType="ComboBox">
                    <Setter Property="Foreground" Value="{DynamicResource LibraryInk}"/>
                    <Setter Property="Background" Value="{DynamicResource LibraryPaper}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource LibraryRule}"/>
                    <Setter Property="MinHeight" Value="30"/>
                    <Setter Property="MaxDropDownHeight" Value="240"/>
                    <Setter Property="ItemContainerStyle">
                        <Setter.Value>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Foreground" Value="{DynamicResource LibraryInk}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ComboBoxItem">
                                            <Border x:Name="Row" CornerRadius="4" Padding="8,4" Background="Transparent">
                                                <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsHighlighted" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource LibrarySelection}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBox">
                                <Grid>
                                    <ToggleButton x:Name="DropDownButton" Focusable="False" ClickMode="Press"
                                                  Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border CornerRadius="5" BorderThickness="1"
                                                        Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <TextBlock Text="▾" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Margin="0,0,8,0" Foreground="{DynamicResource LibraryAccent}"/>
                                    <ContentPresenter IsHitTestVisible="False" ClipToBounds="True" VerticalAlignment="Center" Margin="8,1,24,1"
                                                      Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                                    <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True">
                                        <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                Padding="3" CornerRadius="6" BorderThickness="1"
                                                Background="{DynamicResource LibraryPaper}" BorderBrush="{DynamicResource LibraryRule}">
                                            <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <ItemsPresenter/>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter TargetName="DropDownButton" Property="BorderBrush" Value="{DynamicResource LibraryAccent}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="DropDownButton" Property="Background" Value="{DynamicResource LibraryRecent}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="LibraryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Foreground" Value="{DynamicResource LibraryInk}"/>
                    <Setter Property="Background" Value="{DynamicResource LibraryPaper}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource LibraryRule}"/>
                    <Setter Property="Padding" Value="12,6"/>
                </Style>
                <Style x:Key="LibraryPrimaryButton" TargetType="Button" BasedOn="{StaticResource LibraryButton}">
                    <Setter Property="Background" Value="{DynamicResource LibraryAccent}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource LibraryAccent}"/>
                    <Setter Property="Foreground" Value="{DynamicResource LibraryOnAccent}"/>
                </Style>
                <Style x:Key="LibraryRailButton" TargetType="Button" BasedOn="{StaticResource LibraryButton}">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Margin" Value="0,1,3,1"/>
                    <Setter Property="Padding" Value="8,5"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="RailButtonBase" Padding="{TemplateBinding Padding}" CornerRadius="6"
                                        BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="RailButtonBase" Property="Background" Value="{DynamicResource LibrarySelection}"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="RailButtonBase" Property="BorderBrush" Value="{DynamicResource LibraryAccent}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="LibraryRailItem" TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Margin" Value="0,0,3,2"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="RailItemBase" Background="Transparent" BorderBrush="Transparent"
                                        BorderThickness="1" CornerRadius="6" Padding="8,6" SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="RailItemBase" Property="Background" Value="{DynamicResource LibrarySelection}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="RailItemBase" Property="BorderBrush" Value="{DynamicResource LibraryRule}"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="RailItemBase" Property="BorderBrush" Value="{DynamicResource LibraryAccent}"/>
                                    </Trigger>
                                    <Trigger Property="Tag" Value="collection-drop">
                                        <Setter TargetName="RailItemBase" Property="Background" Value="{DynamicResource LibrarySelection}"/>
                                        <Setter TargetName="RailItemBase" Property="BorderBrush" Value="{DynamicResource LibraryAccent}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="LibraryResumeButton" TargetType="Button" BasedOn="{StaticResource LibraryRailButton}">
                    <Setter Property="Width" Value="236"/>
                    <Setter Property="Margin" Value="0,0,8,8"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="{DynamicResource LibraryRecent}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource LibraryRule}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="narrow">
                            <Setter Property="Width" Value="151"/>
                            <Setter Property="Padding" Value="8"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
                <Style x:Key="LibraryResumeProgress" TargetType="ProgressBar">
                    <Setter Property="Height" Value="3"/>
                    <Setter Property="Margin" Value="0,6,0,0"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                    <Setter Property="Foreground" Value="{DynamicResource LibraryAccent}"/>
                    <Setter Property="Background" Value="{DynamicResource LibraryRule}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ProgressBar">
                                <Grid ClipToBounds="True">
                                    <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="1.5"/>
                                    <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                            HorizontalAlignment="Left" CornerRadius="1.5"/>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Percent}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
                <Style x:Key="LibraryBookOpenButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Foreground" Value="{DynamicResource LibraryInk}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent"><ContentPresenter/></Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="LibraryBookOrganizerButton" TargetType="Button" BasedOn="{StaticResource LibraryRailButton}">
                    <Setter Property="Content" Value="···"/>
                    <Setter Property="ToolTip" Value="整理书籍（Shift+F10）"/>
                    <Setter Property="AutomationProperties.Name" Value="{Binding Display.Title, StringFormat='整理《{0}》'}"/>
                    <Setter Property="Width" Value="27"/>
                    <Setter Property="Height" Value="26"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="{DynamicResource LibraryAccent}"/>
                </Style>
                <DataTemplate x:Key="LibraryCover">
                    <Border CornerRadius="3,7,7,3" ClipToBounds="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#435E64"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Format}" Value="epub">
                                        <Setter Property="Background" Value="#32675D"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Format}" Value="pdf">
                                        <Setter Property="Background" Value="#79504B"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Format}" Value="txt">
                                        <Setter Property="Background" Value="#55604D"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Format}" Value="html">
                                        <Setter Property="Background" Value="#4B5C77"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Format}" Value="docx">
                                        <Setter Property="Background" Value="#425D72"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Display.Cover}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Path Data="M0,58 C37,15 84,15 120,34 L120,120 L0,120 Z"
                                  VerticalAlignment="Bottom" Fill="#19EBF2D9" Stretch="Fill" Height="64"/>
                                <Border Width="4" HorizontalAlignment="Left" Background="#2DFFFFFF"/>
                                <Border Width="1" HorizontalAlignment="Left" Margin="7,0,0,0" Background="#20FFFFFF"/>
                                <Viewbox Stretch="Uniform" StretchDirection="Both" Margin="14,13,9,14">
                                    <Grid Width="88" Height="114">
                                        <TextBlock Foreground="#F9F6E8" FontFamily="Segoe UI, Microsoft YaHei UI"
                                                   FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="79"
                                                   VerticalAlignment="Top" Text="{Binding Display.Title}"/>
                                        <StackPanel VerticalAlignment="Bottom">
                                            <Rectangle Width="23" Height="1" Fill="#CDE7D7" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                            <TextBlock Foreground="#E8F0E4" FontSize="9" FontWeight="SemiBold" Text="{Binding FormatLabel}"/>
                                        </StackPanel>
                                    </Grid>
                                </Viewbox>
                            </Grid>
                            <Image Source="{Binding Display.Cover}" Stretch="Uniform" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                </DataTemplate>
                <DataTemplate x:Key="LibraryShelfGridItem">
                    <Grid Width="133">
                        <Button Click="OnOpenLibraryBook" Style="{StaticResource LibraryBookOpenButton}"
                                AutomationProperties.Name="{Binding Display.Title}">
                            <StackPanel Width="111" Margin="10,10,0,9">
                                <ContentControl Width="111" Height="139" HorizontalAlignment="Left"
                                                Content="{Binding}" ContentTemplate="{StaticResource LibraryCover}" Focusable="False"/>
