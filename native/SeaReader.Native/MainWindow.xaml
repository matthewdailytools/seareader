<Window x:Class="SeaReader.Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SeaReader.Native"
        Title="SeaReader" Width="1120" Height="770" MinWidth="400" MinHeight="370"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14"
        Background="{DynamicResource WindowSurface}" Foreground="{DynamicResource MainInk}"
        AllowDrop="True" PreviewDragOver="OnDragOver" PreviewDrop="OnDrop" PreviewKeyDown="OnKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowSurface" Color="#F2EEE5"/>
        <SolidColorBrush x:Key="PaperSurface" Color="#FFFDFA"/>
        <SolidColorBrush x:Key="ToolbarSurface" Color="#FFFCF5"/>
        <SolidColorBrush x:Key="MainInk" Color="#30271F"/>
        <SolidColorBrush x:Key="MutedInk" Color="#66594B"/>
        <SolidColorBrush x:Key="BorderInk" Color="#D7C9B8"/>
        <SolidColorBrush x:Key="AccentInk" Color="#873B2A"/>
        <SolidColorBrush x:Key="HoverSurface" Color="#EDE3D5"/>
        <Thickness x:Key="ReaderInsets">24,10</Thickness>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MainInk}"/>
            <Setter Property="Background" Value="{DynamicResource PaperSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderInk}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource AccentInk}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource AccentInk}"/>
                                <Setter TargetName="ButtonSurface" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value=".5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AccentInk}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource MainInk}"/>
            <Setter Property="Background" Value="{DynamicResource PaperSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderInk}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="6,4,0,4"/>
            <Setter Property="MinHeight" Value="29"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid x:Name="LibrarySurface" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,20" LastChildFill="True">
                <Button DockPanel.Dock="Right" Click="OnImport" Style="{StaticResource PrimaryButton}" Content="导入文件"/>
                <Button DockPanel.Dock="Right" Click="OnSubscriptions" Content="订阅下载"/>
                <Button DockPanel.Dock="Right" Click="OnOcr" Content="OCR" ToolTip="识别图片中的文字"/>
                <TextBlock Text="SeaReader" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <DockPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Left" Text="书库" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button DockPanel.Dock="Right" Click="OnOpenSelection" Content="打开"/>
                <TextBox x:Name="LibrarySearch" AutomationProperties.Name="搜索书库" MinWidth="140"
                         Margin="0,0,8,0" ToolTip="搜索书名" TextChanged="OnLibrarySearchChanged"/>
            </DockPanel>
            <ListBox x:Name="LibraryList" Grid.Row="2" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     BorderBrush="{DynamicResource BorderInk}" Background="{DynamicResource PaperSurface}"
                     Foreground="{DynamicResource MainInk}" MouseDoubleClick="OnLibraryDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="10,7">
                            <Border Background="{DynamicResource HoverSurface}" CornerRadius="4" Padding="7,4" Margin="0,0,10,0">
                                <TextBlock Text="{Binding Format}" FontSize="11"/>
                            </Border>
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyLibrary" Grid.Row="2" Text="将电子书拖入窗口，或点击导入文件。"
                       TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="36"
                       Foreground="{DynamicResource MutedInk}" IsHitTestVisible="False"/>
        </Grid>

        <Grid x:Name="ReaderSurface" Visibility="Collapsed" Background="{DynamicResource WindowSurface}"
              PreviewMouseLeftButtonDown="OnReaderPointerDown" PreviewMouseLeftButtonUp="OnReaderPointerUp"
              PreviewMouseMove="OnReaderPointerMove" MouseLeave="OnReaderPointerLeave" PreviewMouseWheel="OnReaderWheel">
            <Border x:Name="Paper" Margin="22,12" MaxWidth="820" Background="{DynamicResource PaperSurface}"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderInk}" ClipToBounds="True" CornerRadius="5"
                    AutomationProperties.HelpText="点击正文中部或按 F 显示阅读控制栏。">
                <Grid>
                    <RichTextBox x:Name="TextList" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource MainInk}" IsReadOnly="True"
                                 FontFamily="{DynamicResource ReaderFont}" FontSize="{DynamicResource ReaderSize}"
                                 HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden"
                                 Padding="{DynamicResource ReaderInsets}" AutomationProperties.Name="正文" SelectionChanged="OnTextSelectionChanged"
                                 ScrollViewer.ScrollChanged="OnTextScrollChanged"/>
                    <ScrollViewer x:Name="PdfSurface" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto" Focusable="True" SizeChanged="OnPdfSurfaceSizeChanged">
                        <Grid x:Name="PdfPageHost" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12">
                            <Image x:Name="PdfPageImage" Stretch="Fill" AutomationProperties.Name="PDF 页面"/>
                            <local:PdfSelectionLayer x:Name="PdfSelection" AutomationProperties.Name="PDF 正文"
                                                     AutomationProperties.HelpText="拖动选中文字。按 Ctrl+C 复制，按 Ctrl+F 查找。"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border x:Name="ReaderHeader" Panel.ZIndex="2" Visibility="Collapsed" VerticalAlignment="Top"
                    Margin="12,10,12,0" Padding="8,4" Background="{DynamicResource ToolbarSurface}"
                    BorderBrush="{DynamicResource BorderInk}" BorderThickness="1" CornerRadius="8">
                <DockPanel LastChildFill="True">
                    <Button Click="OnBack" DockPanel.Dock="Left" Content="‹ 书库"/>
                    <Button x:Name="SearchButton" DockPanel.Dock="Right" Tag="Search" Click="OnPanelButton"
                            ToolTip="查找（Ctrl+F）" Content="查找"/>
                    <Button x:Name="ReturnPositionButton" DockPanel.Dock="Right" Visibility="Collapsed"
                            Click="OnReturnPosition" Content="返回原位置"/>
                    <TextBlock x:Name="ReaderTitle" Margin="8,0" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Foreground="{DynamicResource MutedInk}"/>
                </DockPanel>
            </Border>

            <Border x:Name="ReaderToolbar" Panel.ZIndex="2" Visibility="Collapsed" VerticalAlignment="Bottom"
                    HorizontalAlignment="Center" MaxWidth="760" Margin="12,0,12,12" Padding="8"
                    Background="{DynamicResource ToolbarSurface}" BorderBrush="{DynamicResource BorderInk}"
                    BorderThickness="1" CornerRadius="9" SizeChanged="OnReaderToolbarSizeChanged">
                <StackPanel>
                    <Grid Margin="2,0,2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PreviousButton" Content="‹" AutomationProperties.Name="上一页" Tag="-1" Click="OnTurnButton"/>
                        <Slider x:Name="PositionSlider" Grid.Column="1" VerticalAlignment="Center" Margin="8,0"
                                Minimum="0" Maximum="1" IsMoveToPointEnabled="True"
                                AutomationProperties.Name="阅读进度" ValueChanged="OnPositionSliderChanged"/>
                        <Button x:Name="NextButton" Grid.Column="2" Content="›" AutomationProperties.Name="下一页" Tag="1" Click="OnTurnButton"/>
                    </Grid>
                    <WrapPanel HorizontalAlignment="Center">
                        <Button x:Name="ContentsButton" Tag="Contents" Click="OnPanelButton" Content="目录"/>
                        <Button Tag="Appearance" x:Name="AppearanceButton" Click="OnPanelButton" Content="Aa 排版"/>
                        <Button x:Name="FlowButton" Tag="Flow" Click="OnPanelButton" Content="阅读方式"/>
                        <Button Tag="Bookmarks" Click="OnPanelButton" Content="书签"/>
                        <Button Tag="Notes" Click="OnPanelButton" Content="笔记"/>
                        <Button x:Name="ReaderToolsButton" Click="OnReaderTools" Content="工具">
                            <Button.ContextMenu>
                                <ContextMenu Placement="Top" Opened="OnReaderToolsOpened" Closed="OnReaderToolsClosed">
                                    <MenuItem Header="翻译…" Click="OnTranslate"/>
                                    <MenuItem Header="OCR…" Click="OnOcr"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Click="OnToggleControls" Content="收起" ToolTip="收起控制栏（F 或 Esc）"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border x:Name="ReaderPanel" Panel.ZIndex="4" Visibility="Collapsed" VerticalAlignment="Bottom"
                    HorizontalAlignment="Center" MinWidth="260" MaxWidth="400" MaxHeight="330"
                    Margin="12,0,12,117" Padding="14,9,14,12" Background="{DynamicResource ToolbarSurface}"
                    BorderBrush="{DynamicResource BorderInk}" BorderThickness="1" CornerRadius="9">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,7">
                        <Button DockPanel.Dock="Right" Content="关闭" Click="OnClosePanel"/>
                        <TextBlock x:Name="PanelTitle" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <Grid x:Name="SearchPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="查找" Click="OnFind"/>
                                <TextBox x:Name="ReaderSearch" AutomationProperties.Name="查找书中文字" KeyDown="OnReaderSearchKey"/>
                            </DockPanel>
                            <TextBlock x:Name="SearchStatus" Grid.Row="1" Foreground="{DynamicResource MutedInk}" Margin="0,5,0,3"/>
                            <ListBox x:Name="SearchResults" Grid.Row="2" DisplayMemberPath="Excerpt" MaxHeight="220"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MouseDoubleClick="OnSearchResultDoubleClick" KeyDown="OnSearchResultKey"/>
                        </Grid>
                        <StackPanel x:Name="AppearancePanel" Visibility="Collapsed">
                            <StackPanel x:Name="TextAppearancePanel">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="字号"/>
                                    <TextBlock x:Name="FontSizeLabel" DockPanel.Dock="Right" VerticalAlignment="Center" Text="18"/>
                                    <Slider x:Name="FontSizeSlider" Minimum="12" Maximum="44" TickFrequency="1" IsSnapToTickEnabled="True"
                                            AutomationProperties.Name="字号" ValueChanged="OnFontSizeChanged" Margin="12,0"/>
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="字体"/>
                                    <ComboBox x:Name="FontPicker" AutomationProperties.Name="字体" SelectionChanged="OnFontChanged">
                                        <ComboBoxItem Content="系统字体" Tag="system-ui"/>
                                        <ComboBoxItem Content="衬线字体" Tag="Georgia"/>
                                        <ComboBoxItem Content="无衬线字体" Tag="sans-serif"/>
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="段距"/>
                                    <Slider x:Name="ParagraphSlider" Minimum="1.4" Maximum="2.2" TickFrequency=".2" IsSnapToTickEnabled="True"
                                            AutomationProperties.Name="段距" ValueChanged="OnParagraphSpacingChanged" Margin="12,0"/>
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="页边距"/>
                                    <Slider x:Name="MarginSlider" Minimum="12" Maximum="52" TickFrequency="4" IsSnapToTickEnabled="True"
                                            AutomationProperties.Name="页边距" ValueChanged="OnMarginChanged" Margin="12,0"/>
                                </DockPanel>
                            </StackPanel>
                            <DockPanel x:Name="PdfAppearancePanel" Visibility="Collapsed">
                                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="缩放"/>
                                <ComboBox x:Name="ZoomPicker" AutomationProperties.Name="PDF 缩放" SelectionChanged="OnZoomChanged">
                                    <ComboBoxItem Content="适合页面" Tag="page"/>
                                    <ComboBoxItem Content="适合宽度" Tag="width"/>
                                    <ComboBoxItem Content="150%" Tag="150"/>
                                </ComboBox>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="主题"/>
                                <ComboBox x:Name="ThemePicker" AutomationProperties.Name="主题" SelectionChanged="OnThemeChanged">
                                    <ComboBoxItem Content="跟随系统" Tag="system"/>
                                    <ComboBoxItem Content="浅色" Tag="light"/>
                                    <ComboBoxItem Content="护眼" Tag="sepia"/>
                                    <ComboBoxItem Content="深色" Tag="dark"/>
                                </ComboBox>
                            </DockPanel>
                        </StackPanel>
                        <StackPanel x:Name="FlowPanel" Visibility="Collapsed">
                            <Button Content="连续滚动" Tag="scroll" Click="OnFlowMode"/>
                            <Button Content="按页翻阅" Tag="page" Click="OnFlowMode"/>
                            <DockPanel x:Name="EncodingPanel">
                                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="文本编码"/>
                                <ComboBox x:Name="EncodingPicker" AutomationProperties.Name="文本编码" SelectionChanged="OnEncodingChanged">
                                    <ComboBoxItem Content="UTF-8" Tag="utf-8"/>
                                    <ComboBoxItem Content="简体中文 (GB18030)" Tag="gb18030"/>
                                    <ComboBoxItem Content="西欧 (Windows-1252)" Tag="windows-1252"/>
                                    <ComboBoxItem Content="日语 (Shift_JIS)" Tag="shift_jis"/>
                                    <ComboBoxItem Content="UTF-16 LE" Tag="utf-16le"/>
                                    <ComboBoxItem Content="UTF-16 BE" Tag="utf-16be"/>
                                </ComboBox>
                            </DockPanel>
                        </StackPanel>
                        <StackPanel x:Name="ContentsPanel" Visibility="Collapsed">
                            <ListBox x:Name="ContentsList" DisplayMemberPath="Title" MaxHeight="230"
                                     MouseDoubleClick="OnContentsDoubleClick" KeyDown="OnContentsKey"/>
                            <DockPanel x:Name="JumpPanel">
                                <Button DockPanel.Dock="Right" Content="前往" Click="OnJump"/>
                                <TextBox x:Name="JumpInput" AutomationProperties.Name="页码" KeyDown="OnJumpKey"/>
                            </DockPanel>
                        </StackPanel>
                        <StackPanel x:Name="BookmarksPanel" Visibility="Collapsed">
                            <ListBox x:Name="BookmarksList" DisplayMemberPath="Label" MaxHeight="205"
                                     MouseDoubleClick="OnBookmarkDoubleClick" KeyDown="OnBookmarkKey"/>
                            <WrapPanel>
                                <Button Content="添加当前位置" Click="OnAddBookmark"/>
                                <Button Content="删除所选书签" Click="OnRemoveBookmark"/>
                            </WrapPanel>
                        </StackPanel>
                        <StackPanel x:Name="NotesPanel" Visibility="Collapsed">
                            <TextBlock x:Name="NoteQuote" TextWrapping="Wrap" MaxHeight="54"
                                       Foreground="{DynamicResource MutedInk}" Margin="0,0,0,4"/>
                            <TextBox x:Name="NoteInput" AutomationProperties.Name="笔记"
                                     TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="65" MaxLength="12000"/>
                            <WrapPanel Margin="0,4">
                                <Button x:Name="SaveNoteButton" Content="保存选区笔记" Click="OnSaveNote"/>
                                <Button Content="删除所选笔记" Click="OnRemoveNote"/>
                            </WrapPanel>
                            <ListBox x:Name="NotesList" DisplayMemberPath="Quotation" MaxHeight="130"
                                     MouseDoubleClick="OnNoteDoubleClick" KeyDown="OnNoteKey"
                                     SelectionChanged="OnNoteSelectionChanged"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Button x:Name="ShowControlsButton" Panel.ZIndex="2" VerticalAlignment="Bottom"
                    HorizontalAlignment="Center" MinHeight="20" Padding="10,0" FontSize="13" Margin="0,0,0,5"
                    Content="···" AutomationProperties.Name="显示阅读控制栏" ToolTip="显示阅读控制栏（F）"
                    Click="OnToggleControls"/>
        </Grid>
        <Border x:Name="StatusSurface" Visibility="Collapsed" Panel.ZIndex="6" VerticalAlignment="Top"
                HorizontalAlignment="Center" Margin="16,62,16,0" Padding="10,5" CornerRadius="5"
                Background="{DynamicResource ToolbarSurface}" BorderBrush="{DynamicResource BorderInk}" BorderThickness="1"
                IsHitTestVisible="False">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource MainInk}"
                       AutomationProperties.LiveSetting="Polite"/>
        </Border>
    </Grid>
</Window>
