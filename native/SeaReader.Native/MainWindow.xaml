                    </Grid>
                </DataTemplate>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LibraryRailColumn" Width="200"/>
                <ColumnDefinition x:Name="LibraryContentColumn" Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="LibraryNavigationRail" Grid.RowSpan="2" Background="{DynamicResource LibraryRail}"
                    BorderThickness="0,0,1,0" BorderBrush="{DynamicResource LibraryRule}" Padding="14,20,14,13">
                <ScrollViewer x:Name="LibraryRailScroll" HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel>
                        <DockPanel x:Name="LibraryBrand" Margin="3,1,0,25" LastChildFill="True">
                            <Border DockPanel.Dock="Left" Background="{DynamicResource LibraryAccent}" Width="30" Height="30"
                                    CornerRadius="7" Margin="0,0,8,0">
                                <Path Stroke="{DynamicResource LibraryOnAccent}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 6,11 C 10,8 14,8 17,10 L 17,19 C 14,17 10,17 6,20 Z M 17,10 C 20,8 24,8 26,10 L 26,19 C 24,17 20,17 17,19"
                                      Width="20" Height="17" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="SeaReader" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ListBox x:Name="LibrarySections" ItemsPanel="{StaticResource LibraryRailStack}"
                                 SelectionChanged="OnLibrarySectionChanged" BorderThickness="0" Background="Transparent"
                                 AutomationProperties.Name="书库导航" KeyboardNavigation.DirectionalNavigation="Contained"
                                 Foreground="{DynamicResource LibraryInk}">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource LibraryRailItem}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{Binding Glyph}" Stroke="{DynamicResource LibraryAccent}" StrokeThickness="1.4"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="15" Height="15" Margin="0,0,9,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Label}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border x:Name="LibraryRailSeparator" Height="1" Background="{DynamicResource LibraryRule}" Margin="3,13,4,9"/>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Visibility, ElementName=LibraryBrand}" Value="Collapsed">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=LibraryCollectionRail}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="收藏" Margin="8,0,0,4" FontSize="12" Foreground="{DynamicResource LibraryQuiet}"/>
                            <ListBox x:Name="LibraryCollectionRail" ItemsPanel="{StaticResource LibraryRailStack}"
                                     SelectionChanged="OnLibraryCollectionSelectionChanged" PreviewDragLeave="OnLibraryBookDragLeave"
                                     BorderThickness="0" Background="Transparent" AutomationProperties.Name="收藏"
                                     KeyboardNavigation.DirectionalNavigation="Contained" Foreground="{DynamicResource LibraryInk}">
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate>
                                </ListBox.Template>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource LibraryRailItem}">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                        <Setter Property="ToolTip" Value="{Binding Name}"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <Grid Margin="3,4,3,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="LibraryCollections" DisplayMemberPath="Name"
                                      SelectionChanged="OnLibraryCollectionSelectionChanged" AutomationProperties.Name="收藏"
                                      MinWidth="66" MinHeight="30" MaxDropDownHeight="240" VerticalContentAlignment="Center"
                                      ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}, TargetNullValue=选择收藏}"
                                      ScrollViewer.CanContentScroll="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox" BasedOn="{StaticResource LibraryPicker}">
                                        <Setter Property="Margin" Value="0,1,4,1"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=LibraryBrand}" Value="Collapsed">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                                <ComboBox.ItemsPanel>
                                    <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                                </ComboBox.ItemsPanel>
                            </ComboBox>
                            <TextBlock Text="收藏" Margin="7,0,24,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       HorizontalAlignment="Left" Foreground="{DynamicResource LibraryQuiet}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Visibility, ElementName=LibraryBrand}" Value="Collapsed"/>
                                                    <Condition Binding="{Binding SelectedIndex, ElementName=LibraryCollections}" Value="-1"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Padding="5,4" MinHeight="30" Margin="0,1" HorizontalAlignment="Left"
                                    Content="+ 新建收藏" Click="OnCreateLibraryCollection" AutomationProperties.Name="新建收藏">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource LibraryButton}">
                                        <Setter Property="Grid.Row" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=LibraryBrand}" Value="Collapsed">
                                                <Setter Property="Grid.Row" Value="0"/>
                                                <Setter Property="Grid.Column" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                        <WrapPanel x:Name="LibraryServiceLinks" Orientation="Vertical">
                            <Button Style="{StaticResource LibraryRailButton}" Click="OnSubscriptions" Tag="Subscriptions"
                                    AutomationProperties.Name="订阅">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M2,2 C9,2 14,7 14,14 M2,7 C6,7 9,10 9,14 M2,13 L3,14"
                                          Stroke="{DynamicResource LibraryAccent}" StrokeThickness="1.5" StrokeStartLineCap="Round"
                                          Width="15" Height="15" Margin="0,0,9,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Text="订阅"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource LibraryRailButton}" Click="OnSubscriptions" Tag="Downloads"
                                    AutomationProperties.Name="下载">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M8,1 L8,10 M4,6 L8,10 L12,6 M2,10 L2,14 L14,14 L14,10"
                                          Stroke="{DynamicResource LibraryAccent}" StrokeThickness="1.5" StrokeLineJoin="Round"
                                          Width="15" Height="15" Margin="0,0,9,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Text="下载"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="LibraryReadingGoalsButton" Style="{StaticResource LibraryRailButton}"
                                    Click="OnShowReadingGoals" AutomationProperties.Name="阅读目标">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M8,1 A7,7 0 0 1 8,15 A7,7 0 0 1 8,1 M8,4 L8,8 L11,10"
                                          Stroke="{DynamicResource LibraryAccent}" StrokeThickness="1.5" StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="15"
                                          Margin="0,0,9,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Text="阅读目标"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="LibraryExportButton" Click="OnExportLibraryReadingData"
                                    Style="{StaticResource LibraryRailButton}"
                                    AutomationProperties.Name="导出阅读数据"
                                    AutomationProperties.HelpText="将书目、进度、标注和收藏等保存为 JSON 文件。">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M2,9 L2,14 L14,14 L14,9 M8,10 L8,2 M5,5 L8,2 L11,5"
                                          Stroke="{DynamicResource LibraryInk}" StrokeThickness="1.35"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="15"
                                          Margin="0,0,9,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Text="导出阅读数据"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="LibraryRestoreButton" Click="OnRestoreLibraryReadingData"
                                    Style="{StaticResource LibraryRailButton}"
                                    AutomationProperties.Name="恢复阅读数据"
                                    AutomationProperties.HelpText="从 SeaReader 的 JSON 文件补入缺少的阅读记录。">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M2,9 L2,14 L14,14 L14,9 M8,2 L8,10 M5,7 L8,10 L11,7"
                                          Stroke="{DynamicResource LibraryInk}" StrokeThickness="1.35"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="15"
                                          Margin="0,0,9,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Text="恢复阅读数据"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Grid x:Name="LibraryContent" Grid.Column="1" Grid.RowSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LibraryRule}"
                        Padding="23,14,23,13" Background="{DynamicResource LibraryCanvas}">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Click="OnImport" Style="{StaticResource LibraryPrimaryButton}" Content="导入"/>
                        <Button DockPanel.Dock="Right" Click="OnOcr" Style="{StaticResource LibraryButton}"
                                Content="OCR" ToolTip="识别图片中的文字" AutomationProperties.Name="图片文字识别"/>
                        <Button x:Name="LibrarySearchToggle" DockPanel.Dock="Right" Click="OnFocusLibrarySearch"
                                Style="{StaticResource LibraryButton}" ToolTip="搜索书名（Ctrl+F）" Content="搜索"/>
                        <TextBlock x:Name="LibraryViewTitle" Text="首页" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" AutomationProperties.HeadingLevel="Level1"/>
                    </DockPanel>
                </Border>
                <Border x:Name="LibrarySearchPanel" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource LibraryPaper}"
                        BorderBrush="{DynamicResource LibraryRule}" BorderThickness="0,0,0,1" Padding="23,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Click="OnCloseLibrarySearch" Style="{StaticResource LibraryButton}" Content="取消"/>
                        <TextBox x:Name="LibrarySearch" AutomationProperties.Name="搜索书库" MinWidth="100"
                                 Background="{DynamicResource LibraryCanvas}" Foreground="{DynamicResource LibraryInk}"
                                 BorderBrush="{DynamicResource LibraryRule}" VerticalContentAlignment="Center" Margin="0,0,7,0"
                                 ToolTip="搜索书名或作者" TextChanged="OnLibrarySearchChanged" KeyDown="OnLibrarySearchKey"/>
                    </DockPanel>
                </Border>
                <Border x:Name="LibraryStatus" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource LibraryRecent}"
                        BorderBrush="{DynamicResource LibraryRule}" BorderThickness="0,0,0,1" Padding="23,8">
                    <ScrollViewer MaxHeight="86" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="LibraryStatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    </ScrollViewer>
                </Border>
                <ScrollViewer Grid.Row="3" x:Name="LibraryContentScroll" HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto" Padding="23,18,23,19" Focusable="False">
                    <StackPanel x:Name="LibraryShelf" MaxWidth="1140" HorizontalAlignment="Stretch">
                        <StackPanel x:Name="LibraryContinueSection" Visibility="Collapsed" Margin="0,0,0,23">
                            <TextBlock Text="继续阅读" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,9"
                                       AutomationProperties.HeadingLevel="Level2"/>
                            <ItemsControl x:Name="LibraryContinueList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid PreviewMouseRightButtonUp="OnContinueBookOrganizer" PreviewKeyDown="OnContinueBookKeyDown">
                                            <Button x:Name="ContinueBookOpenButton" Click="OnOpenLibraryBook" Style="{StaticResource LibraryResumeButton}"
                                                    AutomationProperties.Name="{Binding Book.Display.Title, StringFormat='继续阅读 {0}'}"
                                                    AutomationProperties.HelpText="{Binding Detail}">
                                                <DockPanel Margin="0,0,27,0">
                                                    <ContentControl DockPanel.Dock="Left" Width="44" Height="62" Margin="0,0,10,0"
                                                                    Content="{Binding Book}" ContentTemplate="{StaticResource LibraryCover}" Focusable="False"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Book.Display.Title}" FontWeight="SemiBold" FontSize="14"
                                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="42"/>
                                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource LibraryQuiet}"
                                                                   TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,3,0,0"/>
                                                        <ProgressBar x:Name="ContinueBookProgress" Maximum="100"
                                                                     Value="{Binding Percent, Mode=OneWay, TargetNullValue=0}"
                                                                     Style="{StaticResource LibraryResumeProgress}" AutomationProperties.Name="阅读进度"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                            <Button x:Name="ContinueBookMoreButton" Click="OnContinueBookOrganizer"
                                                    Style="{StaticResource LibraryBookOrganizerButton}" ToolTip="继续阅读选项（Shift+F10）"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,8"
                                                    AutomationProperties.Name="{Binding Book.Display.Title, StringFormat='《{0}》的继续阅读选项'}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Grid Margin="0,0,0,9">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="LibraryCollectionTitle" Text="书架" FontSize="19" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" AutomationProperties.HeadingLevel="Level2"/>
                                <TextBlock x:Name="LibraryCount" Foreground="{DynamicResource LibraryQuiet}" FontSize="12"
                                           Margin="8,3,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <WrapPanel HorizontalAlignment="Right">
                                <WrapPanel.Style>
                                    <Style TargetType="WrapPanel">
                                        <Setter Property="Grid.Column" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=LibraryBrand}" Value="Collapsed">
                                                <Setter Property="Grid.Row" Value="1"/>
                                                <Setter Property="Grid.Column" Value="0"/>
                                                <Setter Property="Grid.ColumnSpan" Value="2"/>
                                                <Setter Property="Margin" Value="0,4,0,0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </WrapPanel.Style>
                                <Button x:Name="LibrarySeeAll" Click="OnLibrarySeeAll" Style="{StaticResource LibraryRailButton}"
                                        Content="查看全部" Visibility="Collapsed"/>
                                <ComboBox x:Name="LibrarySort" SelectionChanged="OnLibrarySortChanged"
                                          Style="{StaticResource LibraryPicker}" AutomationProperties.Name="排序方式" MinWidth="100"
                                          Margin="0,1,5,1" Visibility="Collapsed">
                                    <ComboBoxItem Content="最近阅读" Tag="recent" IsSelected="True"/>
                                    <ComboBoxItem Content="按书名" Tag="title"/>
                                    <ComboBoxItem Content="按作者" Tag="author"/>
                                    <ComboBoxItem Content="手动排序" Tag="manual"/>
                                </ComboBox>
                                <Button x:Name="LibraryViewToggle" Click="OnToggleLibraryView" Style="{StaticResource LibraryButton}"
                                        Padding="9,4" Margin="0,1,0,1" MinWidth="50" MinHeight="30" Content="列表"
                                        ToolTip="切换书目视图" AutomationProperties.Name="切换为列表视图" Visibility="Collapsed"/>
                                <StackPanel x:Name="LibraryCollectionActions" Orientation="Horizontal" Margin="5,0,0,0"
                                            Visibility="Collapsed">
                                    <Button Style="{StaticResource LibraryRailButton}" Click="OnRenameLibraryCollection"
                                            Padding="5,4" Content="重命名"/>
                                    <Button Style="{StaticResource LibraryRailButton}" Click="OnRemoveLibraryCollection"
                                            Padding="5,4" Content="删除收藏"/>
                                </StackPanel>
                            </WrapPanel>
                        </Grid>
                        <TextBlock x:Name="LibraryManualHint" Visibility="Collapsed" Margin="0,0,0,8" FontSize="12"
                                   Text="拖动书卡，或选中后按 Ctrl+↑／↓ 调整顺序。" Foreground="{DynamicResource LibraryQuiet}" TextWrapping="Wrap"/>
                        <ListBox x:Name="LibraryList" BorderThickness="0" Background="Transparent"
                                 PreviewMouseRightButtonUp="OnLibraryBookMenuPointer"
                                 PreviewMouseLeftButtonDown="OnLibraryDragPointerDown" PreviewMouseLeftButtonUp="OnLibraryDragPointerUp"
                                 PreviewMouseMove="OnLibraryDragPointerMove" PreviewDragLeave="OnLibraryBookDragLeave"
                                 AutomationProperties.Name="书目" KeyboardNavigation.DirectionalNavigation="Contained"
                                 Foreground="{DynamicResource LibraryInk}" PreviewKeyDown="OnLibraryBookKeyDown">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate>
                            </ListBox.Template>
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Setter Property="ItemsPanel" Value="{StaticResource LibraryShelfGridPanel}"/>
                                    <Setter Property="ItemTemplate" Value="{StaticResource LibraryShelfGridItem}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="rows">
                                            <Setter Property="ItemsPanel" Value="{StaticResource LibraryShelfRowsPanel}"/>
                                            <Setter Property="ItemTemplate" Value="{StaticResource LibraryShelfRowItem}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Display.Title}"/>
                                    <Setter Property="Margin" Value="0,0,10,11"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="LibraryTile" BorderThickness="1" BorderBrush="{DynamicResource LibraryRule}"
                                                        Background="{DynamicResource LibraryPaper}" CornerRadius="10">
                                                    <Grid>
                                                        <ContentPresenter/>
                                                        <Border x:Name="ColumnDropMark" Width="3" Margin="0,4" HorizontalAlignment="Left"
                                                                Background="{DynamicResource LibraryAccent}" CornerRadius="1.5" Visibility="Collapsed"
                                                                IsHitTestVisible="False"/>
                                                        <Border x:Name="RowDropMark" Height="3" Margin="4,0" VerticalAlignment="Top"
                                                                Background="{DynamicResource LibraryAccent}" CornerRadius="1.5" Visibility="Collapsed"
                                                                IsHitTestVisible="False"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="Tag" Value="column-before">
                                                        <Setter TargetName="ColumnDropMark" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                    <Trigger Property="Tag" Value="column-after">
                                                        <Setter TargetName="ColumnDropMark" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="ColumnDropMark" Property="HorizontalAlignment" Value="Right"/>
                                                    </Trigger>
                                                    <Trigger Property="Tag" Value="row-before">
                                                        <Setter TargetName="RowDropMark" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                    <Trigger Property="Tag" Value="row-after">
                                                        <Setter TargetName="RowDropMark" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="RowDropMark" Property="VerticalAlignment" Value="Bottom"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="rows">
                                                        <Setter TargetName="LibraryTile" Property="CornerRadius" Value="6"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="LibraryTile" Property="BorderBrush" Value="{DynamicResource LibraryAccent}"/>
                                                        <Setter TargetName="LibraryTile" Property="Background" Value="{DynamicResource LibrarySelection}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="LibraryTile" Property="BorderBrush" Value="{DynamicResource LibraryAccent}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="LibraryTile" Property="BorderBrush" Value="{DynamicResource LibraryAccent}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="rows">
                                            <Setter Property="Margin" Value="0,0,0,5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <Button x:Name="LibraryMoreButton" Content="显示更多" HorizontalAlignment="Left" Visibility="Collapsed"
                                Style="{StaticResource LibraryButton}" Click="OnLibraryMore" Margin="0,3,0,0"/>
                        <Border x:Name="EmptyLibrary" Visibility="Collapsed" CornerRadius="10" Padding="18,17"
                                Background="{DynamicResource LibraryPaper}" BorderBrush="{DynamicResource LibraryRule}" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="LibraryEmptyMessage" TextWrapping="Wrap" TextAlignment="Center"
                                           Foreground="{DynamicResource LibraryQuiet}"/>
                                <Button x:Name="LibraryEmptyImport" Click="OnImport" Content="导入文件" Style="{StaticResource LibraryPrimaryButton}"
                                        Margin="0,8,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid x:Name="ReaderLoadingSurface" Visibility="Collapsed" Background="{DynamicResource WindowSurface}">
            <TextBlock x:Name="ReaderLoadingText" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                       TextWrapping="Wrap" Foreground="{DynamicResource MutedInk}" AutomationProperties.LiveSetting="Polite"/>
        </Grid>

        <Grid x:Name="ReaderSurface" Visibility="Collapsed" Background="{DynamicResource WindowSurface}"
              PreviewMouseLeftButtonDown="OnReaderPointerDown" PreviewMouseLeftButtonUp="OnReaderPointerUp"
              PreviewMouseMove="OnReaderPointerMove" MouseLeave="OnReaderPointerLeave" PreviewMouseWheel="OnReaderWheel"
              PreviewTouchDown="OnReaderTouchDown" PreviewTouchMove="OnReaderTouchMove" PreviewTouchUp="OnReaderTouchUp"
              LostTouchCapture="OnReaderTouchLostCapture"
              SizeChanged="OnReaderSurfaceSizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="ReaderHeader" Grid.RowSpan="2" Panel.ZIndex="2" VerticalAlignment="Top" SizeChanged="OnReaderHeaderSizeChanged"
                    Visibility="Collapsed" MaxWidth="744" Margin="12,10,12,0" Padding="6,4"
                    Background="{DynamicResource FloatingReaderSurface}" BorderThickness="1" CornerRadius="10"
                    BorderBrush="{DynamicResource BorderInk}">
                <DockPanel LastChildFill="True">
                    <Button x:Name="ReaderLibraryButton" Style="{StaticResource ReaderAction}" Click="OnBack"
                            DockPanel.Dock="Left" Content="‹ 书库"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style x:Key="ReaderHeaderAction" TargetType="Button" BasedOn="{StaticResource ReaderAction}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVisible, ElementName=ExitReaderFullScreenButton}" Value="True">
                                        <Setter Property="Padding" Value="3,3"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Resources>
                        <Button x:Name="ContentsButton" Style="{StaticResource ReaderHeaderAction}" Tag="Contents" Click="OnPanelButton" Content="目录"/>
                        <Button x:Name="SearchButton" Style="{StaticResource ReaderHeaderAction}" Tag="Search" Click="OnPanelButton"
                                ToolTip="查找书中文字或跳到页码（Ctrl+F）" Content="搜索"/>
                        <Button x:Name="AppearanceButton" Style="{StaticResource ReaderHeaderAction}" Click="OnToggleAppearance" Content="排版"/>
                        <Button x:Name="BookmarkButton" Style="{StaticResource ReaderHeaderAction}" Click="OnToggleBookmark"
                                Content="书签" ToolTip="添加或移除当前位置的书签（Ctrl+D）"
                                AutomationProperties.Name="添加当前位置为书签" AutomationProperties.AcceleratorKey="Ctrl+D"/>
                        <Button x:Name="NotesButton" Style="{StaticResource ReaderHeaderAction}" Content="标注"
                                Tag="Notes" Click="OnPanelButton" ToolTip="查看本书的标注与笔记（Ctrl+Shift+N）"
                                AutomationProperties.Name="标注与笔记" AutomationProperties.AcceleratorKey="Ctrl+Shift+N"/>
                        <Button x:Name="ReaderToolsButton" Style="{StaticResource ReaderHeaderAction}" Click="OnReaderTools"
                                Content="更多" AutomationProperties.Name="更多阅读工具">
                            <Button.ContextMenu>
                                <ContextMenu Placement="Bottom" Opened="OnReaderToolsOpened" Closed="OnReaderToolsClosed"
                                             PreviewKeyDown="OnReaderToolsKeyDown">
                                    <MenuItem x:Name="FlowButton" Header="切换到上下滚动" Click="OnFlowMode"/>
                                    <MenuItem x:Name="ThemeButton" Header="切换背景" Click="OnCycleTheme"/>
                                    <MenuItem x:Name="TurnMotionMenu" Header="翻页效果"
                                              ToolTip="分页阅读时使用所选翻页效果。"
                                              AutomationProperties.HelpText="按右方向键展开，按上、下方向键选择，按 Enter 应用。">
                                        <MenuItem x:Name="PaperPageTurnMenuItem" Header="纸页翻动" Tag="paper"
                                                  IsCheckable="True" Click="OnPageTurnEffectChanged"/>
                                        <MenuItem x:Name="FadePageTurnMenuItem" Header="快速淡入" Tag="fade"
                                                  IsCheckable="True" Click="OnPageTurnEffectChanged"/>
                                        <MenuItem x:Name="NoPageTurnMenuItem" Header="无动效" Tag="none"
                                                  IsCheckable="True" Click="OnPageTurnEffectChanged"/>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="书签列表" Tag="Bookmarks" InputGestureText="Ctrl+Shift+D" Click="OnPanelButton"/>
                                    <MenuItem x:Name="NotesMenuItem" Header="标注与笔记" Tag="Notes"
                                              InputGestureText="Ctrl+Shift+N" Click="OnPanelButton"/>
                                    <MenuItem x:Name="FixedEpubPagesMenuItem" Header="页码和缩略图" Tag="PdfPages"
                                              InputGestureText="Ctrl+Shift+T" AutomationProperties.AcceleratorKey="Ctrl+Shift+T"
                                              Visibility="Collapsed" Click="OnPanelButton"/>
                                    <MenuItem x:Name="GlossaryMenuItem" Header="本书术语表" Visibility="Collapsed"
                                              Click="OnShowBookGlossary"/>
                                    <MenuItem Header="翻译…" Click="OnTranslate"/>
                                    <MenuItem Header="OCR…" Click="OnOcr"/>
                                    <MenuItem x:Name="EncodingMenu" Header="文本编码" Tag="Encoding" Click="OnPanelButton"/>
                                    <Separator/>
                                    <MenuItem x:Name="ReaderFullScreenMenu" Header="全屏阅读" InputGestureText="F11" Click="OnToggleReaderFullScreen"/>
                                    <MenuItem Header="隐藏工具" InputGestureText="F" Click="OnToggleControls"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="ExitReaderFullScreenButton" Style="{StaticResource ReaderAction}" Visibility="Collapsed"
                                Content="退出全屏" Padding="2,3" ToolTip="退出全屏（F11）" AutomationProperties.AcceleratorKey="F11"
                                Click="OnToggleReaderFullScreen"/>
                    </StackPanel>
                    <TextBlock x:Name="ReaderTitle" Margin="8,0" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                </DockPanel>
            </Border>

            <Border x:Name="SearchPanel" Grid.RowSpan="2" Panel.ZIndex="4" Visibility="Collapsed"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Padding="12"
                    Background="{DynamicResource ToolbarSurface}" BorderBrush="{DynamicResource BorderInk}"
                    BorderThickness="1" CornerRadius="10" AutomationProperties.Name="书内查找">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ReaderSearch" AutomationProperties.Name="查找书中文字或页码" MaxLength="1024"
                                 ToolTip="输入关键词或页码" TextChanged="OnReaderSearchChanged"
                                 PreviewKeyDown="OnReaderSearchPreviewKey" KeyDown="OnReaderSearchKey"/>
                        <TextBlock Text="关键词或页码" Margin="7,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{DynamicResource MutedInk}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=ReaderSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button x:Name="FindButton" Grid.Column="1" Style="{StaticResource ReaderAction}" Content="查找"
                                Margin="5,0,1,0" Click="OnFind"/>
                        <Button Grid.Column="2" Style="{StaticResource ReaderAction}" Content="×" FontSize="17" Padding="7,1"
                                AutomationProperties.Name="关闭书内查找" Click="OnClosePanel"/>
                    </Grid>
                    <TextBlock x:Name="SearchStatus" Grid.Row="1" Visibility="Collapsed" Foreground="{DynamicResource MutedInk}" FontSize="12"
                               Margin="1,7,0,4" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    <ListBox x:Name="SearchResults" Grid.Row="2" MaxHeight="282" Padding="0" BorderThickness="0"
                             Background="Transparent" Foreground="{DynamicResource MainInk}" Visibility="Collapsed"
                             AutomationProperties.Name="查找结果" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonUp="OnSearchResultClick" KeyDown="OnSearchResultKey">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding SpokenLabel}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="8,5"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ResultSurface" CornerRadius="5" Padding="{TemplateBinding Padding}"
                                                    Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ResultSurface" Property="Background" Value="{DynamicResource HoverSurface}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ResultSurface" Property="Background" Value="{DynamicResource HoverSurface}"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="ResultSurface" Property="BorderBrush" Value="{DynamicResource AccentInk}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Location}" Foreground="{DynamicResource AccentInk}" FontSize="11"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Location}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Excerpt}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="52"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border x:Name="FootnotePanel" Grid.RowSpan="2" Panel.ZIndex="5" Visibility="Collapsed"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Padding="10" CornerRadius="10"
                    Background="{DynamicResource ToolbarSurface}" BorderBrush="{DynamicResource BorderInk}" BorderThickness="1"
                    AutomationProperties.Name="书中脚注" KeyboardNavigation.TabNavigation="Cycle">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="3,0,0,6">
                        <Button x:Name="FootnotePanelCloseButton" DockPanel.Dock="Right" Style="{StaticResource ReaderAction}"
                                Content="×" Padding="7,1" FontSize="17"
                                Click="OnClosePanel" AutomationProperties.Name="关闭脚注" ToolTip="关闭脚注（Esc）"/>
                        <TextBlock x:Name="FootnotePanelTitle" Text="脚注" VerticalAlignment="Center" FontSize="15"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource MainInk}" AutomationProperties.HeadingLevel="Level2"/>
                    </DockPanel>
                    <Grid x:Name="GlossaryBrowsePanel" Grid.Row="1" Visibility="Collapsed" Margin="3,0,3,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,6">
                            <Label DockPanel.Dock="Left" Target="{Binding ElementName=GlossarySearchBox}" Content="查找术语"
                                   Padding="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource MainInk}"/>
                            <TextBox x:Name="GlossarySearchBox" MinHeight="26" Padding="6,3" VerticalContentAlignment="Center"
                                     AutomationProperties.Name="查找术语" TextChanged="OnGlossarySearchChanged"/>
                        </DockPanel>
                        <Border Grid.Row="1" CornerRadius="6" BorderThickness="1"
                                Background="{DynamicResource PaperSurface}" BorderBrush="{DynamicResource BorderInk}">
                            <ListBox x:Name="GlossaryTermList" DisplayMemberPath="Term" MaxHeight="74" BorderThickness="0"
                                     Background="Transparent" Foreground="{DynamicResource MainInk}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="术语列表" SelectionChanged="OnGlossaryTermChanged"/>
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="释义" FontSize="12" FontWeight="SemiBold" Margin="3,0,0,4"
                               Foreground="{DynamicResource MutedInk}"
                               Visibility="{Binding Visibility, ElementName=GlossaryBrowsePanel}"/>
                    <TextBox x:Name="FootnoteBody" Grid.Row="3" IsReadOnly="True" IsUndoEnabled="False"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             BorderThickness="0" Padding="3,1" Background="Transparent"
                             FontFamily="{DynamicResource ReaderFont}" FontSize="{DynamicResource ReaderSize}"
                             Foreground="{DynamicResource MainInk}" AutomationProperties.Name="脚注正文"
                             AutomationProperties.LiveSetting="Polite"/>
                </Grid>
            </Border>

            <Border x:Name="ContentsPanel" Grid.RowSpan="2" Panel.ZIndex="4" Visibility="Collapsed"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Width="310" MaxHeight="440" Margin="12,52,0,0"
                    Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource BorderInk}"
                    Background="{DynamicResource ToolbarSurface}" AutomationProperties.Name="本书目录">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="2,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ReaderAction}" Content="×" FontSize="17"
                                Padding="7,1" AutomationProperties.Name="关闭目录" Click="OnClosePanel"/>
                        <TextBlock Text="目录" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MainInk}" AutomationProperties.HeadingLevel="Level2"/>
                    </DockPanel>
                    <TextBlock x:Name="ContentsStatus" Grid.Row="1" Visibility="Collapsed" Margin="2,0,2,5"
                               Foreground="{DynamicResource MainInk}" FontSize="12" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"/>
                    <ListBox x:Name="ContentsList" Grid.Row="2" Padding="0" BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource MainInk}" HorizontalContentAlignment="Stretch"
                             AutomationProperties.Name="章节和小节"
                             ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.PanningMode="VerticalOnly"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="1" VirtualizingPanel.CacheLengthUnit="Item"
                             PreviewMouseLeftButtonUp="OnContentsClick" KeyDown="OnContentsKey">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="IsEnabled" Value="{Binding CanNavigate}"/>
                                <Setter Property="MinHeight" Value="30"/>
                                <Setter Property="Padding" Value="8,5"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ContentsEntrySurface" CornerRadius="5" Padding="{TemplateBinding Padding}"
                                                    MinHeight="{TemplateBinding MinHeight}" Background="Transparent"
                                                    BorderThickness="1" BorderBrush="Transparent">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsEnabled" Value="True"/>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="ContentsEntrySurface" Property="Background" Value="{DynamicResource HoverSurface}"/>
                                                </MultiTrigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ContentsEntrySurface" Property="Background" Value="{DynamicResource HoverSurface}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter TargetName="ContentsEntrySurface" Property="Background" Value="{DynamicResource HoverSurface}"/>
                                                    <Setter TargetName="ContentsEntrySurface" Property="BorderBrush" Value="{DynamicResource AccentInk}"/>
                                                </DataTrigger>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="ContentsEntrySurface" Property="BorderBrush" Value="{DynamicResource MainInk}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="AutomationProperties.ItemStatus" Value="当前位置"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CanNavigate}" Value="True">
                                        <Setter Property="Cursor" Value="Hand"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" Margin="{Binding Indent}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource MainInk}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CanNavigate}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource MutedInk}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="AutomationProperties.HeadingLevel" Value="Level3"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border x:Name="PdfNavigationPanel" Grid.RowSpan="2" Panel.ZIndex="4" Visibility="Collapsed"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Width="236" MaxHeight="360" Margin="12,52,0,0"
                    Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource BorderInk}"
                    Background="{DynamicResource ToolbarSurface}" AutomationProperties.Name="页面导航">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="2,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ReaderAction}" Content="×" FontSize="17"
                                Padding="7,1" AutomationProperties.Name="关闭页面导航" Click="OnClosePanel"/>
                        <TextBlock Text="页面" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MainInk}" AutomationProperties.HeadingLevel="Level2"/>
                    </DockPanel>
                    <DockPanel x:Name="JumpPanel" Grid.Row="1" Margin="2,0,0,9">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ReaderAction}" Content="前往"
                                Margin="5,0,0,0" ToolTip="前往输入的页码" Click="OnJump"/>
                        <Grid>
                            <TextBox x:Name="JumpInput" AutomationProperties.Name="前往页码" PreviewKeyDown="OnJumpKey"
                                     VerticalContentAlignment="Center" MaxLength="10" InputScope="Digits"
                                     TextChanged="OnPdfJumpTextChanged"/>
                            <TextBlock Text="输入页码" IsHitTestVisible="False" VerticalAlignment="Center" Margin="7,0,0,0"
                                       Foreground="{DynamicResource MutedInk}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=JumpInput}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                    <TextBlock x:Name="PdfJumpError" Grid.Row="2" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource MainInk}" Margin="2,0,2,7"
                               AutomationProperties.LiveSetting="Polite"/>
                    <ListBox x:Name="PdfThumbnailList" Grid.Row="3" Background="Transparent" BorderThickness="0" Padding="0"
                             Foreground="{DynamicResource MainInk}" AutomationProperties.Name="页面缩略图"
                             AutomationProperties.HelpText="按上、下方向键浏览缩略图，按 Enter 前往选中的页。"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.PanningMode="VerticalOnly"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard"
                             VirtualizingPanel.ScrollUnit="Item" VirtualizingPanel.CacheLength="1" VirtualizingPanel.CacheLengthUnit="Item"
                             PreviewMouseLeftButtonUp="OnPdfThumbnailClick" KeyDown="OnPdfThumbnailKey"
                             ScrollViewer.ScrollChanged="OnPdfThumbnailViewportChanged" SizeChanged="OnPdfThumbnailSizeChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Margin" Value="0,0,3,5"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="PageEntrySurface" Background="Transparent" BorderBrush="Transparent"
                                                    BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="PageEntrySurface" Property="Background" Value="{DynamicResource HoverSurface}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="PageEntrySurface" Property="BorderBrush" Value="{DynamicResource BorderInk}"/>
                                                    <Setter TargetName="PageEntrySurface" Property="Background" Value="{DynamicResource HoverSurface}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter TargetName="PageEntrySurface" Property="BorderBrush" Value="{DynamicResource AccentInk}"/>
                                                    <Setter TargetName="PageEntrySurface" Property="Background" Value="{DynamicResource HoverSurface}"/>
                                                </DataTrigger>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="PageEntrySurface" Property="BorderBrush" Value="{DynamicResource MainInk}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="AutomationProperties.ItemStatus" Value="当前页"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Left" Width="82" Height="106" Margin="0,0,10,0"
                                            Background="{DynamicResource PaperSurface}" BorderBrush="{DynamicResource BorderInk}"
                                            BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                                        <Grid>
                                            <Path Data="M2,1 L14,1 L20,7 L20,25 L2,25 Z M14,1 L14,7 L20,7 M6,12 L16,12 M6,16 L16,16 M6,20 L12,20"
                                                  Stroke="{DynamicResource BorderInk}" StrokeThickness="1.2" Stretch="Uniform"
                                                  Width="21" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsHitTestVisible="False">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Image}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <Image Source="{Binding Image}" Stretch="Uniform" IsHitTestVisible="False"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MainInk}"/>
                                        <TextBlock Text="当前页" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource AccentInk}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid x:Name="ReaderStage">
                <Grid x:Name="ReadingLane" SizeChanged="OnReadingLaneSizeChanged">
                    <Grid x:Name="PaperFrame" Margin="24,16" MaxWidth="680">
                        <Grid x:Name="SpreadPageContent" SizeChanged="OnPageEdgeSizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition x:Name="FacingColumn" Width="0"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ReaderPaperBackdrop" Grid.ColumnSpan="2" IsHitTestVisible="False" Background="{DynamicResource ReaderPaper}"
                                    BorderThickness="1" BorderBrush="{DynamicResource ReaderPaperBorder}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity=".1" Color="#30271F" RenderingBias="Performance"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="Paper" Background="{DynamicResource ReaderPaper}"
                                BorderThickness="1" BorderBrush="Transparent" ClipToBounds="True"
                                AutomationProperties.HelpText="将指针移到书页上下沿、点击正文中部或按 F 可显示阅读控制栏。">
                            <Grid>
                                <Grid x:Name="ReaderPageContent">
                                    <RichTextBox x:Name="TextList" BorderThickness="0" Background="Transparent"
                                                 Foreground="{DynamicResource MainInk}" IsReadOnly="True" IsDocumentEnabled="True" InputMethod.IsInputMethodEnabled="False"
                                                 FontFamily="{DynamicResource ReaderFont}" FontSize="{DynamicResource ReaderSize}"
                                                 HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden"
                                                 Padding="{DynamicResource ReaderInsets}" AutomationProperties.Name="正文" SelectionChanged="OnTextSelectionChanged"
                                                 GotKeyboardFocus="OnTextPageFocus"
                                                 ScrollViewer.ScrollChanged="OnTextScrollChanged" SizeChanged="OnTextViewportSizeChanged"/>
                                    <ScrollViewer x:Name="PdfSurface" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto" Focusable="True" SizeChanged="OnPdfSurfaceSizeChanged">
                                        <StackPanel x:Name="PdfSpreadHost" Orientation="Horizontal" Margin="12"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel.Resources>
                                                <Style x:Key="PdfSheet" TargetType="Border">
                                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                                    <Setter Property="Margin" Value="-1"/>
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ReaderPaperBorder}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect BlurRadius="9" ShadowDepth="2" Opacity=".15"
                                                                              Color="#30271F" RenderingBias="Performance"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </StackPanel.Resources>
                                            <Border x:Name="FixedEpubLeftSpace" Visibility="Collapsed" IsHitTestVisible="False"/>
                                            <Grid x:Name="PdfPageHost" VerticalAlignment="Top">
                                                <Border x:Name="PdfPrimaryBacking" Style="{StaticResource PdfSheet}"/>
                                                <Image x:Name="PdfPageImage" Stretch="Fill" AutomationProperties.Name="PDF 页面"/>
                                                <local:PdfSelectionLayer x:Name="PdfSelection" AutomationProperties.Name="PDF 正文"
                                                                         InputMethod.IsInputMethodEnabled="False"
                                                                         AutomationProperties.HelpText="拖动选中文字。按 Ctrl+C 复制，按 Ctrl+F 查找。"/>
                                                <local:FixedEpubLinkLayer x:Name="FixedEpubPrimaryLinks" IsHitTestVisible="False"/>
                                            </Grid>
                                            <Grid x:Name="PdfFacingPageHost" VerticalAlignment="Top" Margin="10,0,0,0" Visibility="Collapsed">
                                                <Border x:Name="PdfFacingBacking" Style="{StaticResource PdfSheet}"/>
                                                <Image x:Name="PdfFacingImage" Stretch="Fill" AutomationProperties.Name="PDF 右页"/>
                                                <local:PdfSelectionLayer x:Name="PdfFacingSelection" AutomationProperties.Name="PDF 右页正文"
                                                                         InputMethod.IsInputMethodEnabled="False"
                                                                         AutomationProperties.HelpText="拖动选中文字。按 Ctrl+C 复制，按 Ctrl+F 查找。"/>
                                                <local:FixedEpubLinkLayer x:Name="FixedEpubFacingLinks" IsHitTestVisible="False"/>
                                            </Grid>
                                            <Border x:Name="FixedEpubRightSpace" Visibility="Collapsed" IsHitTestVisible="False"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                            </Border>
                            <Border x:Name="FacingPaper" Grid.Column="1" Visibility="Collapsed"
                                    Background="{DynamicResource ReaderPaper}" BorderBrush="Transparent"
                                    BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <RichTextBox x:Name="FacingTextList" BorderThickness="0" Background="Transparent"
                                                 Foreground="{DynamicResource MainInk}" IsReadOnly="True" IsDocumentEnabled="True" IsUndoEnabled="False"
                                                 InputMethod.IsInputMethodEnabled="False" FontFamily="{DynamicResource ReaderFont}"
                                                 FontSize="{DynamicResource ReaderSize}" HorizontalScrollBarVisibility="Disabled"
                                                 VerticalScrollBarVisibility="Hidden" Padding="{DynamicResource FacingReaderInsets}"
                                                 AutomationProperties.Name="右页正文" GotKeyboardFocus="OnTextPageFocus"
                                                 SelectionChanged="OnTextSelectionChanged"/>
                                </Grid>
                            </Border>
                            <Button x:Name="ReaderFolio" Grid.ColumnSpan="2" Visibility="Collapsed"
                                    Style="{StaticResource ReaderAction}" Height="22" MinHeight="22" Padding="6,0"
                                    FontSize="11" Foreground="{DynamicResource MutedInk}" Cursor="Hand"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Click="OnShowGoToPage"
                                    ToolTip="前往页码（Ctrl+G）" AutomationProperties.HelpText="点击后可输入页码"/>
                        </Grid>
                    </Grid>
                    <local:PageTurnSurface x:Name="PageTurnLayer" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Width="{Binding ActualWidth, ElementName=PaperFrame}" Height="{Binding ActualHeight, ElementName=PaperFrame}"
                                           SizeChanged="OnPageTurnSurfaceSizeChanged"/>
                    <Button x:Name="LeftPageEdge" Style="{StaticResource PageEdgeButton}" HorizontalAlignment="Left"
                            Content="‹" FontSize="25" Tag="-1" Click="OnTurnButton"
                            AutomationProperties.Name="上一页，左页边"/>
                    <Button x:Name="RightPageEdge" Style="{StaticResource PageEdgeButton}" HorizontalAlignment="Right"
                            Content="›" FontSize="25" Tag="1" Click="OnTurnButton"
                            AutomationProperties.Name="下一页，右页边"/>
                    <Canvas Panel.ZIndex="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Width="{Binding ActualWidth, ElementName=SpreadPageContent}"
                            Height="{Binding ActualHeight, ElementName=SpreadPageContent}">
                        <Button x:Name="ReaderJumpBackButton" Style="{StaticResource ReaderJumpAction}" Canvas.Left="10" Canvas.Bottom="8"
                                Visibility="Collapsed" Click="OnReturnPosition" AutomationProperties.Name="返回原位置"
                                ToolTip="回到跳转前的阅读位置">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="ReaderJumpBackGlyph" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Data="M6,2 L2,6 L6,10 M2,6 H8 Q11,6 11,10"/>
                                <TextBlock x:Name="ReaderJumpBackLabel" Text="返回原位置" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ReaderJumpForwardButton" Style="{StaticResource ReaderJumpAction}" Canvas.Right="10" Canvas.Bottom="8"
                                Visibility="Collapsed" Click="OnReturnPosition" AutomationProperties.Name="前往跳转处"
                                ToolTip="回到刚才查看的阅读位置">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ReaderJumpForwardLabel" Text="前往跳转处" VerticalAlignment="Center"/>
                                <Path x:Name="ReaderJumpForwardGlyph" Width="12" Height="12" Margin="5,0,0,0" VerticalAlignment="Center"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Data="M6,2 L10,6 L6,10 M10,6 H4 Q1,6 1,10"/>
                            </StackPanel>
                        </Button>
                    </Canvas>
                </Grid>

                <Border x:Name="ReaderPanel" Panel.ZIndex="4" Visibility="Collapsed"
                        Padding="16,12" Background="{DynamicResource ToolbarSurface}"
                        BorderBrush="{DynamicResource BorderInk}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,7">
                            <Button DockPanel.Dock="Right" Content="关闭" Click="OnClosePanel"/>
                            <TextBlock x:Name="PanelTitle" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </DockPanel>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <DockPanel x:Name="EncodingPanel" Visibility="Collapsed">
                                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="文本编码"/>
                                    <ComboBox x:Name="EncodingPicker" AutomationProperties.Name="文本编码" SelectionChanged="OnEncodingChanged">
                                        <ComboBoxItem Content="UTF-8" Tag="utf-8"/>
                                        <ComboBoxItem Content="简体中文 (GB18030)" Tag="gb18030"/>
                                        <ComboBoxItem Content="西欧 (Windows-1252)" Tag="windows-1252"/>
                                        <ComboBoxItem Content="日语 (Shift_JIS)" Tag="shift_jis"/>
                                        <ComboBoxItem Content="UTF-16 LE" Tag="utf-16le"/>
                                        <ComboBoxItem Content="UTF-16 BE" Tag="utf-16be"/>
                                    </ComboBox>
                                </DockPanel>
                                <StackPanel x:Name="BookmarksPanel" Visibility="Collapsed">
                                    <Grid Margin="0,0,0,5">
                                        <ListBox x:Name="BookmarksList" MinHeight="32" MaxHeight="205" Padding="0"
                                                 BorderThickness="0" Background="Transparent"
                                                 Foreground="{DynamicResource MainInk}" HorizontalContentAlignment="Stretch"
                                                 AutomationProperties.Name="本书的书签"
                                                 AutomationProperties.HelpText="选中书签后按 Enter 前往原文。"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.PanningMode="VerticalOnly"
                                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                                 MouseDoubleClick="OnBookmarkDoubleClick" KeyDown="OnBookmarkKey">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Padding" Value="8,5"/>
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="BookmarkEntrySurface" CornerRadius="5" Padding="{TemplateBinding Padding}"
                                                                        Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="BookmarkEntrySurface" Property="Background" Value="{DynamicResource HoverSurface}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="BookmarkEntrySurface" Property="Background" Value="{DynamicResource HoverSurface}"/>
                                                                        <Setter TargetName="BookmarkEntrySurface" Property="BorderBrush" Value="{DynamicResource AccentInk}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                        <Setter TargetName="BookmarkEntrySurface" Property="BorderBrush" Value="{DynamicResource MainInk}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock x:Name="BookmarkExcerptText" Text="{Binding Excerpt}" TextWrapping="Wrap"
                                                                   TextTrimming="CharacterEllipsis" LineHeight="18" LineStackingStrategy="BlockLineHeight"
                                                                   MaxHeight="36" Margin="0,0,0,2"/>
                                                        <TextBlock x:Name="BookmarkLocationText" Text="{Binding LocationLabel}" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource MutedInk}"/>
                                                                    <Setter Property="FontSize" Value="11"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Excerpt}" Value="{x:Null}">
                                                                            <Setter Property="Foreground" Value="{DynamicResource MainInk}"/>
                                                                            <Setter Property="FontSize" Value="13"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Excerpt}" Value="">
                                                                            <Setter Property="Foreground" Value="{DynamicResource MainInk}"/>
                                                                            <Setter Property="FontSize" Value="13"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Excerpt}" Value="{x:Null}">
                                                            <Setter TargetName="BookmarkExcerptText" Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Excerpt}" Value="">
                                                            <Setter TargetName="BookmarkExcerptText" Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Text="还没有书签" Foreground="{DynamicResource MutedInk}"
                                                   FontSize="12" Margin="9,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasItems, ElementName=BookmarksList}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <WrapPanel>
                                        <Button Content="添加当前位置" Click="OnAddBookmark"/>
                                        <Button Content="删除所选书签" Click="OnRemoveBookmark"/>
                                    </WrapPanel>
                                </StackPanel>
                                <StackPanel x:Name="NotesPanel" Visibility="Collapsed">
                                    <Grid Margin="0,0,0,7">
                                        <TextBox x:Name="NotesFilterBox" MaxLength="1024" TextChanged="OnNotesSearchChanged"
                                                 AutomationProperties.Name="搜索本书的摘录或笔记"/>
                                        <TextBlock Text="搜索摘录或笔记" Margin="7,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedInk}" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=NotesFilterBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <WrapPanel x:Name="NotesFilterChoices" Margin="0,0,0,6" AutomationProperties.Name="筛选标注">
                                        <RadioButton x:Name="NotesFilterAll" Style="{StaticResource ReaderThemeChoice}" Content="全部"
                                                     Tag="all" GroupName="ReaderNotesFilter" IsChecked="True" Checked="OnNotesFilterChanged"/>
                                        <RadioButton Style="{StaticResource ReaderThemeChoice}" Content="高亮" Tag="highlight"
                                                     GroupName="ReaderNotesFilter" Checked="OnNotesFilterChanged"
                                                     AutomationProperties.Name="高亮和下划线"/>
                                        <RadioButton Style="{StaticResource ReaderThemeChoice}" Content="笔记" Tag="note"
                                                     GroupName="ReaderNotesFilter" Checked="OnNotesFilterChanged"/>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,0,0,9">
                                        <Button x:Name="StudyCardsButton" Style="{StaticResource ReaderAction}" Content="复习卡片"
                                                IsEnabled="False" ToolTip="用本书已保存的标注和笔记复习" Click="OnShowStudyCards"/>
                                        <Button x:Name="ExportAnnotationsButton" Style="{StaticResource ReaderAction}" Content="导出标注…"
                                                IsEnabled="False" ToolTip="将本书标注保存为 Markdown 文档" Click="OnExportAnnotations"/>
                                    </WrapPanel>
                                    <Grid Margin="0,0,0,8">
                                        <ListBox x:Name="NotesList" MinHeight="32" MaxHeight="210" Padding="0"
                                                 BorderThickness="0" Background="Transparent" Foreground="{DynamicResource MainInk}"
                                                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.PanningMode="VerticalOnly" ScrollViewer.CanContentScroll="True"
                                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                                 AutomationProperties.Name="本书的标注与笔记" AutomationProperties.HelpText="选中标注后按 Enter 前往原文。"
                                                 MouseDoubleClick="OnNoteDoubleClick" KeyDown="OnNoteKey" SelectionChanged="OnNoteSelectionChanged">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding Quotation}"/>
                                                    <Setter Property="AutomationProperties.ItemStatus" Value="{Binding LocationLabel}"/>
                                                    <Setter Property="AutomationProperties.HelpText" Value="{Binding Note}"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Padding" Value="8,5"/>
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="NoteEntrySurface" CornerRadius="5" Padding="{TemplateBinding Padding}"
                                                                        Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="NoteEntrySurface" Property="Background" Value="{DynamicResource HoverSurface}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="NoteEntrySurface" Property="Background" Value="{DynamicResource HoverSurface}"/>
                                                                        <Setter TargetName="NoteEntrySurface" Property="BorderBrush" Value="{DynamicResource AccentInk}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                        <Setter TargetName="NoteEntrySurface" Property="BorderBrush" Value="{DynamicResource MainInk}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,3">
                                                            <TextBlock DockPanel.Dock="Right" FontSize="11" Margin="5,0,0,0"
                                                                       Foreground="{DynamicResource AccentInk}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="高亮"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Highlight}" Value="{x:Static local:AnnotationHighlight.None}">
                                                                                <Setter Property="Text" Value="笔记"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Highlight}" Value="{x:Static local:AnnotationHighlight.Underline}">
                                                                                <Setter Property="Text" Value="下划线"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding LocationLabel}" TextTrimming="CharacterEllipsis"
                                                                       FontSize="11" Foreground="{DynamicResource MutedInk}"/>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Quotation}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                                   LineHeight="18" LineStackingStrategy="BlockLineHeight" MaxHeight="36"/>
                                                        <TextBlock Text="{Binding Note}" TextTrimming="CharacterEllipsis" FontSize="11"
                                                                   Foreground="{DynamicResource MutedInk}" Margin="0,2,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Note}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock x:Name="NotesEmptyMessage" Text="本书还没有标注" FontSize="12" Margin="8,0"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" IsHitTestVisible="False"
                                                   Foreground="{DynamicResource MutedInk}" AutomationProperties.LiveSetting="Polite">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasItems, ElementName=NotesList}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock x:Name="NoteQuote" TextWrapping="Wrap" MaxHeight="54"
                                               Foreground="{DynamicResource MutedInk}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="NoteInput" AutomationProperties.Name="笔记"
                                             TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="65" MaxLength="12000"
                                             TextChanged="OnNoteInputChanged"/>
                                    <WrapPanel Margin="0,4">
                                        <Button x:Name="SaveNoteButton" Content="保存笔记" Click="OnSaveNote"/>
                                        <Button x:Name="GoToAnnotationButton" Content="前往标注" Click="OnGoToAnnotation"/>
                                        <Button x:Name="RemoveNoteButton" Content="移除笔记" Click="OnRemoveNote"/>
                                        <Button x:Name="ClearAnnotationMarkButton" Content="清除标记" Click="OnClearAnnotationMark"/>
                                        <Button x:Name="CopyAnnotationButton" Style="{StaticResource ReaderAction}" Content="复制含出处"
                                                Visibility="Collapsed" Click="OnCopyAnnotation"/>
                                        <Button x:Name="ShareAnnotationButton" Style="{StaticResource ReaderAction}" Content="分享…"
                                                Visibility="Collapsed" AutomationProperties.Name="分享所选标注" Click="OnShareAnnotation"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="ReaderToolbar" Grid.RowSpan="2" Panel.ZIndex="2" VerticalAlignment="Bottom"
                    Visibility="Collapsed" MaxWidth="560" Margin="12,0,12,8" Padding="6,3"
                    Background="{DynamicResource FloatingReaderSurface}" BorderThickness="1" CornerRadius="10"
                    BorderBrush="{DynamicResource BorderInk}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PreviousButton" Style="{StaticResource ReaderAction}" Content="‹"
                                AutomationProperties.Name="上一页" Tag="-1" Click="OnTurnButton"/>
                        <Slider x:Name="PositionSlider" Grid.Column="1" VerticalAlignment="Center" Margin="6,0"
                                Style="{StaticResource ReaderProgressSlider}"
                                Minimum="0" Maximum="1" IsSnapToTickEnabled="True" TickFrequency="1" Stylus.IsPressAndHoldEnabled="False"
                                PreviewMouseLeftButtonDown="OnPositionPointerDown" PreviewMouseMove="OnPositionPointerMove"
                                PreviewMouseLeftButtonUp="OnPositionPointerUp"
                                LostMouseCapture="OnPositionLostCapture" ValueChanged="OnPositionSliderChanged"
                                AutomationProperties.Name="阅读进度"
                                AutomationProperties.HelpText="拖动预览阅读位置，松开前往，按 Esc 取消。也可用方向键移动。"/>
                        <Button Grid.Column="2" Style="{StaticResource ReaderAction}" MinWidth="52" Click="OnShowGoToPage"
                                ToolTip="前往页码" AutomationProperties.HelpText="点击后可输入页码">
                            <TextBlock x:Name="ProgressText" Foreground="{DynamicResource MutedInk}"/>
                        </Button>
                        <Button x:Name="NextButton" Grid.Column="3" Style="{StaticResource ReaderAction}" Content="›"
                                AutomationProperties.Name="下一页" ToolTipService.ShowOnDisabled="True" Tag="1" Click="OnTurnButton"/>
                        <Canvas x:Name="PositionPreviewAnchor" Grid.ColumnSpan="4" Panel.ZIndex="1"
                                Height="0" MaxWidth="288" VerticalAlignment="Top" IsHitTestVisible="False">
                            <Border x:Name="PositionPreviewBubble" Visibility="Collapsed" Canvas.Bottom="9"
                                    Width="{Binding ActualWidth, ElementName=PositionPreviewAnchor}" Padding="10,7"
                                    CornerRadius="9" BorderThickness="1" Background="{DynamicResource ToolbarSurface}"
                                    BorderBrush="{DynamicResource BorderInk}">
                                <StackPanel>
                                    <TextBlock x:Name="PositionPreviewLabel" FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MainInk}"/>
                                    <TextBlock x:Name="PositionPreviewDetail" Margin="0,2,0,0" FontSize="12"
                                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedInk}"/>
                                </StackPanel>
                            </Border>
                        </Canvas>
                    </Grid>
                    <StackPanel x:Name="PageJumpPanel" Visibility="Collapsed" Margin="0,4,0,1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Label x:Name="GoToPageLabel" Target="{Binding ElementName=GoToPageBox}" Content="前往页码"
                                   FontSize="12" Padding="0,0,8,0" Foreground="{DynamicResource MutedInk}" VerticalAlignment="Center"/>
                            <TextBox x:Name="GoToPageBox" Width="76" MaxLength="10" InputScope="Digits" Padding="5,3"
                                     VerticalAlignment="Center" PreviewKeyDown="OnGoToPageKeyDown"
                                     TextChanged="OnPrintedPageQueryChanged" AutomationProperties.Name="前往页码"/>
                            <Button Style="{StaticResource ReaderAction}" Content="前往" Click="OnGoToPage"/>
                            <Button x:Name="PageJumpModeButton" Style="{StaticResource ReaderAction}" Content="原书页码"
                                    Visibility="Collapsed" Click="OnPageJumpMode"/>
                        </StackPanel>
                        <ListBox x:Name="PrintedPageMatches" Visibility="Collapsed" MaxWidth="320" MaxHeight="130"
                                 BorderThickness="1" BorderBrush="{DynamicResource ReaderPaperBorder}"
                                 Background="{DynamicResource ToolbarSurface}" Foreground="{DynamicResource MainInk}"
                                 Margin="0,5,0,0" Padding="2" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="原书页码结果"
                                 PreviewKeyDown="OnPrintedPageListKeyDown" MouseDoubleClick="OnPrintedPageDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Display}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Popup x:Name="AppearancePopup" Placement="Custom" PlacementTarget="{Binding ElementName=ReaderSurface}"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                   Opened="OnAppearancePopupOpened">
                <Border x:Name="AppearancePopupFrame" Background="Transparent"
                        Padding="0,0,0,8" Width="344" PreviewKeyDown="OnAppearancePopupKeyDown">
                    <Border Background="{DynamicResource ToolbarSurface}" BorderBrush="{DynamicResource BorderInk}"
                            BorderThickness="1" CornerRadius="12" Padding="14">
                        <Border.Resources>
                            <Style x:Key="ReaderThemeSample" TargetType="Border">
                                <Setter Property="Height" Value="10"/>
                                <Setter Property="Width" Value="32"/>
                                <Setter Property="CornerRadius" Value="3"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Margin" Value="0,1,0,4"/>
                            </Style>
                            <Style x:Key="TypographyPresetChoice" TargetType="RadioButton" BasedOn="{StaticResource ReaderThemeChoice}">
                                <Setter Property="Margin" Value="0,0,6,0"/>
                                <Setter Property="MinHeight" Value="52"/>
                            </Style>
                            <Style x:Key="TypographyPresetSample" TargetType="Border">
                                <Setter Property="Width" Value="49"/>
                                <Setter Property="Height" Value="25"/>
                                <Setter Property="Background" Value="{DynamicResource ReaderPaper}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderInk}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="CornerRadius" Value="3"/>
                                <Setter Property="Margin" Value="0,0,0,3"/>
                            </Style>
                            <Style x:Key="ReaderLayoutChoice" TargetType="RadioButton" BasedOn="{StaticResource ReaderThemeChoice}">
                                <Setter Property="MinHeight" Value="30"/>
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Path x:Name="LayoutSample" Width="17" Height="13" Margin="0,0,5,0" Stretch="Uniform"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                      StrokeThickness="1.2" StrokeLineJoin="Round" VerticalAlignment="Center"
                                                      Data="M1,2 H15 V12 H1 Z M8,2 V12"/>
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="auto">
                                                    <Setter TargetName="LayoutSample" Property="Data" Value="M1,2 H15 V12 H1 Z M3.5,7 H12.5 M5.5,5 L3.5,7 L5.5,9 M10.5,5 L12.5,7 L10.5,9"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="single">
                                                    <Setter TargetName="LayoutSample" Property="Data" Value="M5,1 H12 V12 H5 Z"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value=".55"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Resources>
                        <ScrollViewer x:Name="AppearanceScroll" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Focusable="False">
                            <StackPanel x:Name="AppearancePanel">
                                <TextBlock x:Name="ReaderBackgroundHeading" Text="阅读背景" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MainInk}" Margin="0,0,0,8"/>
                                <UniformGrid x:Name="ThemeChoices" Columns="4" Margin="0,0,-4,12"
                                             KeyboardNavigation.DirectionalNavigation="Cycle">
                                    <RadioButton Style="{StaticResource ReaderThemeChoice}" GroupName="ReaderPaperTheme"
                                                 Tag="system" AutomationProperties.Name="跟随系统背景" Checked="OnReaderThemeChecked">
                                        <StackPanel>
                                            <Border Style="{StaticResource ReaderThemeSample}" BorderBrush="#9EAAA9">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Offset="0" Color="#F7F9F8"/>
                                                        <GradientStop Offset=".5" Color="#F7F9F8"/>
                                                        <GradientStop Offset=".5" Color="#34434D"/>
                                                        <GradientStop Offset="1" Color="#34434D"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Text="跟随系统" FontSize="12" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource ReaderThemeChoice}" GroupName="ReaderPaperTheme"
                                                 Tag="light" AutomationProperties.Name="浅色背景" Checked="OnReaderThemeChecked">
                                        <StackPanel>
                                            <Border Style="{StaticResource ReaderThemeSample}" Background="#F9FBFA" BorderBrush="#BBC7C5"/>
                                            <TextBlock Text="浅色" FontSize="12" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource ReaderThemeChoice}" GroupName="ReaderPaperTheme"
                                                 Tag="sepia" AutomationProperties.Name="护眼背景" Checked="OnReaderThemeChecked">
                                        <StackPanel>
                                            <Border Style="{StaticResource ReaderThemeSample}" Background="#F5ECD7" BorderBrush="#CEBA95"/>
                                            <TextBlock Text="护眼" FontSize="12" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource ReaderThemeChoice}" GroupName="ReaderPaperTheme"
                                                 Tag="dark" AutomationProperties.Name="深色背景" Checked="OnReaderThemeChecked">
                                        <StackPanel>
                                            <Border Style="{StaticResource ReaderThemeSample}" Background="#24313A" BorderBrush="#586A74"/>
                                            <TextBlock Text="深色" FontSize="12" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                </UniformGrid>
                                <StackPanel x:Name="TextAppearancePanel">
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="字号" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button x:Name="FontSizeDecreaseButton" Grid.Column="1" Content="−" Tag="-1"
                                                Style="{StaticResource ReaderAction}" Width="30" MinHeight="30" Padding="0"
                                                FontSize="16" Margin="0" AutomationProperties.Name="减小字号"
                                                ToolTip="减小字号（Ctrl+−）" Click="OnStepFontSize"/>
                                        <Slider x:Name="FontSizeSlider" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,4,0"
                                                Minimum="12" Maximum="44" TickFrequency="1" IsSnapToTickEnabled="True"
                                                AutomationProperties.Name="字号" AutomationProperties.HelpText="Ctrl+加号增大，Ctrl+减号缩小，Ctrl+0 恢复默认字号。"
                                                ValueChanged="OnFontSizeChanged"/>
                                        <TextBlock x:Name="FontSizeLabel" Grid.Column="3" MinWidth="27" VerticalAlignment="Center"
                                                   TextAlignment="Center" Foreground="{DynamicResource MutedInk}" Text="18"/>
                                        <Button x:Name="FontSizeIncreaseButton" Grid.Column="4" Content="+" Tag="1"
                                                Style="{StaticResource ReaderAction}" Width="30" MinHeight="30" Padding="0"
                                                FontSize="16" Margin="0" AutomationProperties.Name="增大字号"
                                                ToolTip="增大字号（Ctrl+加号）" Click="OnStepFontSize"/>
                                    </Grid>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="页面布局" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                                        <TextBlock x:Name="ReaderLayoutStatus" TextAlignment="Right"
                                                   Foreground="{DynamicResource MutedInk}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <UniformGrid x:Name="ReaderLayoutChoices" Columns="3" Margin="0,0,-4,10"
                                                 AutomationProperties.Name="页面布局" KeyboardNavigation.DirectionalNavigation="Cycle">
                                        <RadioButton x:Name="ReaderLayoutAuto" Style="{StaticResource ReaderLayoutChoice}"
                                                     Content="自动" Tag="auto" Checked="OnReaderLayoutChecked"
                                                     AutomationProperties.HelpText="随窗口大小自动显示单页或双页。"
                                                     ToolTip="随窗口大小自动显示单页或双页。"/>
                                        <RadioButton x:Name="ReaderLayoutSingle" Style="{StaticResource ReaderLayoutChoice}"
                                                     Content="单页" Tag="single" Checked="OnReaderLayoutChecked"
                                                     AutomationProperties.HelpText="每次显示一页。" ToolTip="每次显示一页。"/>
                                        <RadioButton x:Name="ReaderLayoutDouble" Style="{StaticResource ReaderLayoutChoice}"
                                                     Content="双页" Tag="double" Checked="OnReaderLayoutChecked"
                                                     AutomationProperties.HelpText="并排显示两页。窗口空间不足时暂用单页。"
                                                     ToolTip="并排显示两页。窗口空间不足时暂用单页。"/>
                                    </UniformGrid>
                                    <DockPanel Margin="0,0,0,5">
                                        <Button x:Name="RestoreCustomTypographyButton" DockPanel.Dock="Right"
                                                Style="{StaticResource ReaderAction}" MinHeight="25" Padding="6,1" Margin="0"
                                                FontSize="12" Content="恢复自定义" Visibility="Collapsed"
                                                AutomationProperties.Name="恢复自定义排版" Click="OnRestoreCustomTypography"/>
                                        <TextBlock Text="排版预设" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <UniformGrid x:Name="TypographyPresets" Columns="3" Margin="0,0,-6,8"
                                                 KeyboardNavigation.DirectionalNavigation="Cycle">
                                        <RadioButton Style="{StaticResource TypographyPresetChoice}" GroupName="ReaderTypographyPreset"
                                                     Tag="classic" AutomationProperties.Name="经典排版"
                                                     AutomationProperties.HelpText="书籍衬线字体和常规页边距。"
                                                     ToolTip="{Binding Path=(AutomationProperties.HelpText), RelativeSource={RelativeSource Self}}"
                                                     Checked="OnTypographyPresetChecked">
                                            <StackPanel>
                                                <Border Style="{StaticResource TypographyPresetSample}">
                                                    <Path Data="M0,0 L28,0 M0,5 L28,5 M0,10 L20,10" Stretch="Uniform"
                                                          Width="28" Height="13" Stroke="{DynamicResource MutedInk}" StrokeThickness="1.2"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="经典" FontSize="12" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource TypographyPresetChoice}" GroupName="ReaderTypographyPreset"
                                                     Tag="airy" AutomationProperties.Name="舒展排版"
                                                     AutomationProperties.HelpText="较宽的页边距和更疏的行距。"
                                                     ToolTip="{Binding Path=(AutomationProperties.HelpText), RelativeSource={RelativeSource Self}}"
                                                     Checked="OnTypographyPresetChecked">
                                            <StackPanel>
                                                <Border Style="{StaticResource TypographyPresetSample}">
                                                    <Path Data="M0,0 L27,0 M0,8 L23,8 M0,16 L16,16" Stretch="Uniform"
                                                          Width="27" Height="16" Stroke="{DynamicResource MutedInk}" StrokeThickness="1.2"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="舒展" FontSize="12" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource TypographyPresetChoice}" GroupName="ReaderTypographyPreset"
                                                     Tag="bold" AutomationProperties.Name="醒目排版"
                                                     AutomationProperties.HelpText="使用系统字体并加粗正文。"
                                                     ToolTip="{Binding Path=(AutomationProperties.HelpText), RelativeSource={RelativeSource Self}}"
                                                     Checked="OnTypographyPresetChecked">
                                            <StackPanel>
                                                <Border Style="{StaticResource TypographyPresetSample}">
                                                    <Path Data="M0,0 L30,0 M0,6 L25,6 M0,12 L20,12" Stretch="Uniform"
                                                          Width="31" Height="15" Stroke="{DynamicResource MainInk}" StrokeThickness="2.4"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="醒目" FontSize="12" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </UniformGrid>
                                    <Expander x:Name="TypographyDetails" Header="详细排版" Foreground="{DynamicResource MainInk}"
                                              AutomationProperties.Name="详细排版设置">
                                        <StackPanel Margin="0,5,0,0">
                                            <Grid TextElement.Foreground="{DynamicResource MainInk}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="66"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="38"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock VerticalAlignment="Center" Text="字体"/>
                                                <ComboBox x:Name="FontPicker" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"
                                                          AutomationProperties.Name="字体" SelectionChanged="OnFontChanged">
                                                    <ComboBoxItem Content="书籍衬线" Tag="book"/>
                                                    <ComboBoxItem Content="宋体" Tag="serif"/>
                                                    <ComboBoxItem Content="系统字体" Tag="system-ui"/>
                                                    <ComboBoxItem Content="Georgia" Tag="Georgia"/>
                                                    <ComboBoxItem Content="无衬线字体" Tag="sans-serif"/>
                                                </ComboBox>
                                                <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,4">
                                                    <CheckBox x:Name="ReaderBoldToggle" Margin="0,2,18,2" VerticalContentAlignment="Center"
                                                              Content="加粗正文" AutomationProperties.Name="加粗正文"
                                                              Foreground="{DynamicResource MainInk}"
                                                              Checked="OnReaderBoldChanged" Unchecked="OnReaderBoldChanged"/>
                                                    <CheckBox x:Name="ReaderHyphenationCheckBox" Margin="0,2" VerticalContentAlignment="Center"
                                                              Content="英文自动断字" AutomationProperties.Name="英文自动断字"
                                                              AutomationProperties.HelpText="在行末按英语规则拆分长词，可减少空白。"
                                                              ToolTip="{Binding Path=(AutomationProperties.HelpText), RelativeSource={RelativeSource Self}}"
                                                              Foreground="{DynamicResource MainInk}"
                                                              Checked="OnReaderHyphenationChanged" Unchecked="OnReaderHyphenationChanged"/>
                                                </WrapPanel>
                                                <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="行距"/>
                                                <Slider x:Name="ParagraphSlider" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"
                                                        Margin="0,7" Minimum="1.4" Maximum="2.2" TickFrequency=".2" IsSnapToTickEnabled="True"
                                                        AutomationProperties.Name="行距" ValueChanged="OnParagraphSpacingChanged"/>
                                                <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                                                           Foreground="{DynamicResource MutedInk}" Text="{Binding Value, ElementName=ParagraphSlider, StringFormat={}{0:0.0}}"/>
                                                <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="段落对齐"/>
                                                <ComboBox x:Name="ParagraphAlignmentPicker" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"
                                                          AutomationProperties.Name="段落对齐" SelectionChanged="OnParagraphAlignmentChanged">
                                                    <ComboBoxItem Content="左对齐" Tag="left"/>
                                                    <ComboBoxItem Content="两端对齐" Tag="justify"/>
                                                </ComboBox>
                                                <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="页边距"/>
                                                <Slider x:Name="MarginSlider" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center"
                                                        Margin="0,7" Minimum="12" Maximum="52" TickFrequency="4" IsSnapToTickEnabled="True"
                                                        AutomationProperties.Name="页边距" ValueChanged="OnMarginChanged"/>
                                                <TextBlock Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                                                           Foreground="{DynamicResource MutedInk}" Text="{Binding Value, ElementName=MarginSlider, StringFormat={}{0:0}}"/>
                                                <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="逐行辅助"/>
                                                <ComboBox x:Name="LineGuidePicker" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"
                                                          AutomationProperties.Name="逐行辅助"
                                                          AutomationProperties.HelpText="点击正文选择一行。焦点在正文时，按上、下方向键逐行移动。"
                                                          ToolTip="{Binding Path=(AutomationProperties.HelpText), RelativeSource={RelativeSource Self}}"
                                                          SelectionChanged="OnLineGuideChanged">
                                                    <ComboBoxItem Content="关闭" Tag="off"/>
                                                    <ComboBoxItem Content="轻度淡化" Tag="soft"/>
                                                    <ComboBoxItem Content="明显淡化" Tag="strong"/>
                                                </ComboBox>
                                            </Grid>
                                            <Button Style="{StaticResource ReaderAction}" HorizontalAlignment="Right" MinHeight="27"
                                                    Padding="8,2" FontSize="12" Margin="0,5,0,0"
                                                    Content="恢复默认" AutomationProperties.Name="恢复默认排版" Click="OnResetTypography"/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                                <StackPanel x:Name="PdfAppearancePanel" Visibility="Collapsed">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"
                                                   Text="显示方式" Foreground="{DynamicResource MainInk}"/>
                                        <ComboBox x:Name="ZoomPicker" AutomationProperties.Name="PDF 显示方式" SelectionChanged="OnZoomChanged">
                                            <ComboBoxItem Content="适合页面" Tag="page"/>
                                            <ComboBoxItem Content="适合宽度" Tag="width"/>
                                            <ComboBoxItem Content="适合双页" Tag="spread"/>
                                            <ComboBoxItem Content="150%" Tag="150"/>
                                        </ComboBox>
                                    </DockPanel>
                                    <TextBlock x:Name="PdfLayoutStatus" Margin="0,5,0,0" Visibility="Collapsed"
                                               Foreground="{DynamicResource MutedInk}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Border>
            </Popup>

            <StackPanel x:Name="CompactReaderControls" Grid.Row="1" HorizontalAlignment="Center"
                        Orientation="Horizontal" Margin="0,0,0,6">
                <Button x:Name="CompactProgressButton" Style="{StaticResource ReaderAction}" MinHeight="22" Padding="6,0" Margin="0,0,5,0"
                        Click="OnShowGoToPage" ToolTip="前往页码" AutomationProperties.HelpText="点击后可输入页码">
                    <TextBlock x:Name="CompactProgressText" Foreground="{DynamicResource MutedInk}"/>
                </Button>
                <TextBlock x:Name="ChapterRemainingText" FontSize="12" VerticalAlignment="Center" Margin="0,0,9,0"
                           Foreground="{DynamicResource MutedInk}" Visibility="Collapsed"/>
                <Button x:Name="LineGuideExit" Style="{StaticResource ReaderActiveAction}" Height="22" MinHeight="22"
                        Padding="6,0" Margin="0,0,5,0" Content="结束逐行" Visibility="Collapsed"
                        AutomationProperties.Name="关闭逐行辅助" ToolTip="关闭逐行辅助" Click="OnTurnOffLineGuide"/>
                <Button x:Name="ShowControlsButton" MinHeight="22" Padding="8,0" FontSize="12"
                        Content="显示工具" AutomationProperties.Name="显示阅读控制栏" ToolTip="显示阅读控制栏（F）"
                        Click="OnToggleControls"/>
            </StackPanel>
            <Canvas Grid.RowSpan="2" Panel.ZIndex="3">
                <Border x:Name="InlineSelectionCard" Visibility="Collapsed" CornerRadius="9" Padding="4"
                        BorderThickness="1" Background="{DynamicResource FloatingReaderSurface}"
                        BorderBrush="{DynamicResource BorderInk}" AutomationProperties.Name="选中文字的快捷操作">
                    <Grid>
                        <StackPanel x:Name="InlineSelectionActions" Orientation="Horizontal">
                            <Button x:Name="InlineSelectionHighlight" Style="{StaticResource ReaderAction}" Content="高亮"
                                    AutomationProperties.Name="选择高亮颜色" Click="OnInlineSelectionHighlight"/>
                            <Button x:Name="InlineSelectionNote" Style="{StaticResource ReaderAction}" Content="笔记"
                                    AutomationProperties.Name="为选中文字写笔记" Click="OnInlineSelectionNote"/>
                            <Button x:Name="InlineSelectionCopy" Style="{StaticResource ReaderAction}" Content="复制"
                                    AutomationProperties.Name="复制选中文字" Click="OnInlineSelectionCopy"/>
                            <Button x:Name="InlineSelectionSearch" Style="{StaticResource ReaderAction}" Content="查找"
                                    AutomationProperties.Name="在书内查找选中文字" Click="OnInlineSelectionSearch"/>
                            <Button x:Name="InlineSelectionTranslate" Style="{StaticResource ReaderAction}" Content="翻译"
                                    AutomationProperties.Name="翻译选中文字" Click="OnInlineSelectionTranslate"/>
                            <Button x:Name="InlineSelectionClearMark" Style="{StaticResource ReaderAction}" Content="移除高亮"
                                    Visibility="Collapsed" Click="OnInlineSelectionClearMark"/>
                        </StackPanel>
                        <StackPanel x:Name="InlineSelectionColors" Orientation="Horizontal" Visibility="Collapsed">
                            <Button Style="{StaticResource ReaderAction}" Content="琥珀" Tag="Amber" Click="OnInlineSelectionColor"/>
                            <Button Style="{StaticResource ReaderAction}" Content="薄荷绿" Tag="Mint" Click="OnInlineSelectionColor"/>
                            <Button Style="{StaticResource ReaderAction}" Content="淡紫" Tag="Lavender" Click="OnInlineSelectionColor"/>
                            <Button Style="{StaticResource ReaderAction}" Content="下划线" Tag="Underline" Click="OnInlineSelectionColor"/>
                        </StackPanel>
                        <StackPanel x:Name="InlineSelectionEditor" Width="266" Margin="5" Visibility="Collapsed">
                            <TextBlock x:Name="InlineSelectionNoteQuote" MaxHeight="37" Margin="2,0,2,6" FontSize="12"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedInk}"/>
                            <TextBox x:Name="InlineSelectionNoteInput" AutomationProperties.Name="选区笔记" Height="84" MaxLength="12000"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     TextChanged="OnInlineSelectionNoteInputChanged" PreviewKeyDown="OnInlineSelectionNoteKeyDown"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                <Button x:Name="InlineSelectionNoteRemove" Style="{StaticResource ReaderAction}" Content="删除笔记"
                                        Visibility="Collapsed" Click="OnInlineSelectionNoteRemove"/>
                                <Button Style="{StaticResource ReaderAction}" Content="取消" Click="OnCancelInlineSelectionNote"/>
                                <Button x:Name="InlineSelectionNoteSave" Style="{StaticResource ReaderActiveAction}" Content="保存笔记"
                                        IsEnabled="False" Click="OnSaveInlineSelectionNote"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Canvas>
        </Grid>
        <Border x:Name="StatusSurface" Visibility="Collapsed" Panel.ZIndex="6" VerticalAlignment="Top"
                HorizontalAlignment="Center" Margin="16,62,16,0" Padding="10,5" CornerRadius="5"
                Background="{DynamicResource ToolbarSurface}" BorderBrush="{DynamicResource BorderInk}" BorderThickness="1"
                IsHitTestVisible="False">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource MainInk}"
                       AutomationProperties.LiveSetting="Polite"/>
        </Border>
    </Grid>
</Window>
