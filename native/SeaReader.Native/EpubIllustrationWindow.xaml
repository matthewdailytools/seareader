<Window x:Class="SeaReader.Native.EpubIllustrationWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="查看插图" Width="940" Height="720" MinWidth="336" MinHeight="260"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        FontFamily="Segoe UI" FontSize="14"
        Background="{DynamicResource WindowSurface}" Foreground="{DynamicResource MainInk}"
        Loaded="OnLoaded" PreviewKeyDown="OnKeyDown">
    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="IllustrationScroll" Focusable="True"
                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      PanningMode="Both" CanContentScroll="False"
                      AutomationProperties.Name="插图视图"
                      AutomationProperties.HelpText="按加号和减号缩放，按 0 恢复适合窗口。放大后可以拖动插图或用方向键平移。"
                      SizeChanged="OnViewportSizeChanged" PreviewMouseWheel="OnZoomWheel">
            <Border x:Name="IllustrationSurface" Background="Transparent" Padding="14"
                    PreviewMouseLeftButtonDown="OnPanDown" PreviewMouseMove="OnPanMove"
                    PreviewMouseLeftButtonUp="OnPanUp" LostMouseCapture="OnPanLostCapture">
                <Image x:Name="IllustrationImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="1" Padding="12,8" Background="{DynamicResource PaperSurface}"
                BorderBrush="{DynamicResource BorderInk}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="ZoomOutButton" Content="−" MinWidth="34" MinHeight="32"
                            AutomationProperties.Name="缩小插图" AutomationProperties.AcceleratorKey="-"
                            ToolTip="缩小（−）" Click="OnZoomOut"/>
                    <TextBlock x:Name="ZoomLevelText" Text="100%" MinWidth="50" TextAlignment="Center"
                               VerticalAlignment="Center" Foreground="{DynamicResource MutedInk}"/>
                    <Button x:Name="ZoomInButton" Content="+" MinWidth="34" MinHeight="32"
                            AutomationProperties.Name="放大插图" AutomationProperties.AcceleratorKey="+"
                            ToolTip="放大（+）" Click="OnZoomIn"/>
                    <Button x:Name="ZoomFitButton" Content="适合窗口" MinHeight="32"
                            AutomationProperties.AcceleratorKey="0" ToolTip="适合窗口（0）" Click="OnZoomFit"/>
                </StackPanel>
                <Button x:Name="CloseIllustrationButton" Grid.Column="1" Content="关闭" MinHeight="32"
                        AutomationProperties.Name="关闭插图" AutomationProperties.AcceleratorKey="Esc" Click="OnClose"/>
            </Grid>
        </Border>
    </Grid>
</Window>
