<Window x:Class="SeaReader.Native.OcrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图片识字" Width="650" Height="690" MinWidth="445" MinHeight="435"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="14"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*" MinHeight="65"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*" MinHeight="80"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Margin="0,0,0,12">
            <Button x:Name="ChooseImageButton" Content="选择图片" Padding="12,5" Margin="0,0,7,4" Click="OnChooseImage"/>
            <Button x:Name="UsePageButton" Content="当前 PDF 页" Padding="12,5" Margin="0,0,7,4" Click="OnUsePage"/>
            <ComboBox x:Name="RecognitionLanguage" SelectedIndex="0" MinWidth="130" Padding="8,4"
                      AutomationProperties.Name="识别语言" Margin="0,0,7,4">
                <ComboBoxItem Content="自动 · 中英日" Tag="auto"/>
                <ComboBoxItem Content="简体中文" Tag="chi_sim"/>
                <ComboBoxItem Content="英语" Tag="eng"/>
                <ComboBoxItem Content="日语" Tag="jpn"/>
            </ComboBox>
            <Button x:Name="RecognizeButton" Content="识别" Padding="13,5" Margin="0,0,7,4" Click="OnRecognize"/>
            <Button x:Name="CancelButton" Content="取消" Padding="11,5" Margin="0,0,7,4"
                    Visibility="Collapsed" Click="OnCancel"/>
        </WrapPanel>

        <Border Grid.Row="1" CornerRadius="4" Padding="8" BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
            <Grid>
                <TextBlock x:Name="ImageHint" Text="请选择需要识别的图片" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image x:Name="Preview" Stretch="Uniform" AutomationProperties.Name="待识别图片"/>
            </Grid>
        </Border>

        <Label Grid.Row="2" Content="识别结果" Target="{Binding ElementName=Result}" Padding="0" Margin="0,13,0,5"/>
        <TextBox x:Name="Result" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Padding="7" MaxLength="250000"
                 AutomationProperties.Name="识别结果" TextChanged="OnResultChanged"/>

        <StackPanel Grid.Row="4" Margin="0,8,0,0">
            <TextBlock x:Name="Status" Margin="0,0,0,5" TextWrapping="Wrap" MinHeight="21"
                       AutomationProperties.LiveSetting="Polite"/>
            <WrapPanel>
                <Button x:Name="CopyButton" Content="复制" Padding="11,5" Margin="0,0,7,4" Click="OnCopy"/>
                <Button x:Name="ExportButton" Content="导出 TXT" Padding="11,5" Margin="0,0,7,4" Click="OnExport"/>
                <Button x:Name="SavePageButton" Content="保存到本页" Padding="11,5" Margin="0,0,7,4" Click="OnSavePage"/>
                <Button x:Name="TranslateButton" Content="翻译结果" Padding="11,5" Margin="0,0,7,4" Click="OnTranslate"/>
                <Button Content="关闭" Padding="11,5" IsCancel="True" Margin="0,0,0,4"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
