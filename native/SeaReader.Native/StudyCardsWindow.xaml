<Window x:Class="SeaReader.Native.StudyCardsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="复习卡片" Width="584" Height="460" MinWidth="345" MinHeight="294"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        FontFamily="Segoe UI" FontSize="14"
        Background="{DynamicResource WindowSurface}" Foreground="{DynamicResource MainInk}"
        Loaded="OnLoaded" PreviewKeyDown="OnStudyCardKeyDown">
    <Window.Resources>
        <Style x:Key="StudyButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MainInk}"/>
            <Setter Property="Background" Value="{DynamicResource PaperSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderInk}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentInk}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentInk}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverSurface}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value=".55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="18,16" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="PreviousStudyCardButton" Content="上一张" Style="{StaticResource StudyButton}"
                    AutomationProperties.AcceleratorKey="Left" Click="OnPreviousCard"/>
            <TextBlock x:Name="StudyCardPosition" Grid.Column="1" TextAlignment="Center" VerticalAlignment="Center"
                       FontWeight="SemiBold"/>
            <Button x:Name="NextStudyCardButton" Grid.Column="2" Content="下一张" Style="{StaticResource StudyButton}"
                    AutomationProperties.AcceleratorKey="Right" Click="OnNextCard"/>
        </Grid>
        <Button x:Name="FlipStudyCardButton" Grid.Row="1" Style="{StaticResource StudyButton}"
                Background="{DynamicResource ReaderPaper}" BorderBrush="{DynamicResource ReaderPaperBorder}"
                Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                Cursor="Hand" AutomationProperties.AcceleratorKey="Enter" Click="OnFlipCard">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource PaperSurface}" BorderBrush="{DynamicResource BorderInk}"
                        BorderThickness="0,0,0,1" CornerRadius="5,5,0,0" Padding="16,10">
                    <DockPanel>
                        <TextBlock x:Name="StudyCardFlipLabel" DockPanel.Dock="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentInk}" FontSize="13"/>
                        <TextBlock x:Name="StudyCardSide" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <ScrollViewer x:Name="StudyCardScroll" Grid.Row="1" Padding="16,14"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly" Focusable="False">
                    <TextBlock x:Name="StudyCardText" FontSize="18" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"/>
                </ScrollViewer>
            </Grid>
        </Button>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Enter 翻面 · 空格下一张" TextWrapping="Wrap" FontSize="12"
                       Margin="0,0,8,0" Foreground="{DynamicResource MutedInk}" VerticalAlignment="Center"/>
            <Button x:Name="LocateStudyCardButton" Grid.Column="1" Content="定位原文" Style="{StaticResource StudyButton}"
                    BorderBrush="{DynamicResource AccentInk}" Margin="0,0,8,0" Click="OnLocateCard"/>
            <Button x:Name="CloseStudyCardsButton" Grid.Column="2" Content="关闭" Style="{StaticResource StudyButton}"
                    AutomationProperties.AcceleratorKey="Esc" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
