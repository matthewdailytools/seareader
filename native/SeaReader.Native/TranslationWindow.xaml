<Window x:Class="SeaReader.Native.TranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="离线翻译" Width="600" Height="525" MinWidth="380" MinHeight="380"
        WindowStartupLocation="CenterOwner" Background="#FFFDF8">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,12">
            <Label Target="{Binding ElementName=SourceLanguage}">原文语言</Label>
            <ComboBox x:Name="SourceLanguage" Width="96" Margin="0,0,10,0" SelectedValuePath="Tag" SelectedIndex="0">
                <ComboBoxItem Tag="auto">自动识别</ComboBoxItem>
                <ComboBoxItem Tag="zh">简体中文</ComboBoxItem>
                <ComboBoxItem Tag="en">英语</ComboBoxItem>
                <ComboBoxItem Tag="ja">日语</ComboBoxItem>
            </ComboBox>
            <Label Target="{Binding ElementName=TargetLanguage}">目标语言</Label>
            <ComboBox x:Name="TargetLanguage" Width="96" SelectedValuePath="Tag" SelectedIndex="1">
                <ComboBoxItem Tag="zh">简体中文</ComboBoxItem>
                <ComboBoxItem Tag="en">英语</ComboBoxItem>
                <ComboBoxItem Tag="ja">日语</ComboBoxItem>
            </ComboBox>
        </WrapPanel>
        <Label Grid.Row="1" Target="{Binding ElementName=InputText}" Padding="0,0,0,5">原文</Label>
        <TextBox x:Name="InputText" Grid.Row="2" AcceptsReturn="True" MaxLength="6000" Padding="8"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
        <Label Grid.Row="3" Target="{Binding ElementName=OutputText}" Padding="0,10,0,5">译文</Label>
        <TextBox x:Name="OutputText" Grid.Row="4" IsReadOnly="True" Padding="8"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
        <StackPanel Grid.Row="5" Margin="0,12,0,0">
            <WrapPanel>
                <Button x:Name="TranslateButton" Click="OnTranslate" Padding="12,5" Margin="0,0,8,5" IsDefault="True">翻译</Button>
                <Button x:Name="InstallButton" Click="OnInstall" Padding="12,5" Margin="0,0,8,5">安装离线模型</Button>
                <Button x:Name="CancelButton" Click="OnCancel" Padding="12,5" IsEnabled="False" Margin="0,0,8,5">取消任务</Button>
                <Button x:Name="CopyButton" Click="OnCopy" Padding="12,5" IsEnabled="False" Margin="0,0,0,5">复制译文</Button>
            </WrapPanel>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Grid>
</Window>
